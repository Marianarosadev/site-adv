# Cabeçalhos HTTP servidos pela Cloudflare junto com os arquivos de dist/.

# Arquivos gerados pelo build têm um código no nome que muda a cada alteração: podem ficar em cache por 1 ano.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Vídeos e imagem de compartilhamento mantêm o mesmo nome quando trocados: cache de 7 dias.
/video/*
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=604800
