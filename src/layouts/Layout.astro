---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import { site, whatsappLink, areas } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
}

const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
const home = Astro.url.pathname === '/' ? '' : '/';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7eeeb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content="Dra. Giovanna Cabral, Advogada Trabalhista em Goiânia" />
    <meta property="og:description" content="Orientação clara sobre os seus direitos trabalhistas. Atendimento 100% online." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {schema.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="header" data-header>
      <div class="container header__inner">
        <a class="brand" href={`${home}#topo`} aria-label={`${site.fullName}, página inicial`}>
          <span class="brand__mark" aria-hidden="true"><span class="mono-g">G</span><span class="mono-c">C</span><span class="mono-g mono-g--over">G</span></span>
          <span>
            <span class="brand__name">Giovanna Cabral</span>
            <span class="brand__role">Advocacia Trabalhista</span>
          </span>
        </a>
        <nav class="nav" aria-label="Seções">
          <a href={`${home}#como-posso-ajudar`}>Como posso ajudar</a>
          <a href={`${home}#sobre`}>Sobre</a>
          <a href={`${home}#como-funciona`}>Como funciona</a>
          <a href={`${home}#duvidas`}>Dúvidas</a>
          <a href={`${home}#contato`}>Contato</a>
        </nav>
        <Button href={whatsappLink()} icon="whatsapp">
          <span class="btn__label-long">Falar no WhatsApp</span><span class="btn__label-short">WhatsApp</span>
        </Button>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__top">
        <div>
          <p class="footer__call">Fale direto com a advogada, sem intermediários.</p>
          <a class="footer__phone" href={whatsappLink()} target="_blank" rel="noopener">{site.phoneShort}</a>
          <p class="footer__call">WhatsApp · {site.hours}</p>
        </div>
        <div class="footer__cols">
          <div>
            <h2>Atendimento</h2>
            <p>Online<br />{site.city} e todo o Brasil</p>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
          <div>
            <h2>Áreas</h2>
            <ul>
              {areas.slice(0, 5).map((area) => (
                <li><a href={`${home}#como-posso-ajudar`}>{area.title}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h2>Site</h2>
            <ul>
              <li><a href={`${home}#sobre`}>Sobre</a></li>
              <li><a href={`${home}#como-funciona`}>Como funciona</a></li>
              <li><a href={`${home}#duvidas`}>Dúvidas</a></li>
              <li><a href="/politica-de-privacidade/">Política de privacidade</a></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="container footer__legal">
        <p>
          {site.fullName}, Advogada, {site.oab}. Conteúdo de caráter exclusivamente informativo, que não constitui
          consultoria jurídica. O envio de mensagem não cria relação de contratação. Não envie documentos ou
          informações sigilosas antes do primeiro retorno.
        </p>
        <div class="footer__bottom">
          <span>© {new Date().getFullYear()} Giovanna Cabral</span>
          <a href="/politica-de-privacidade/">Política de privacidade</a>
        </div>
      </div>
      <div class="footer__watermark" aria-hidden="true">Giovanna Cabral</div>
    </footer>

    <a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Conversar com a Dra. Giovanna pelo WhatsApp" data-wa-float>
      <Icon name="whatsapp" />
    </a>

    <script>
      const header = document.querySelector('[data-header]');
      const float = document.querySelector('[data-wa-float]');
      const hero = document.querySelector('[data-hero]');

      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // O botão flutuante aparece depois que o topo sai da tela (ou sempre, em páginas sem topo).
      if (hero && float) {
        new IntersectionObserver(([entry]) => float.classList.toggle('is-visible', !entry.isIntersecting), {
          rootMargin: '-120px 0px 0px 0px',
        }).observe(hero);
      } else {
        float?.classList.add('is-visible');
      }

      const reveals = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        }
      }, { rootMargin: '0px 0px -8% 0px' });
      reveals.forEach((el) => revealObserver.observe(el));
    </script>
  </body>
</html>
