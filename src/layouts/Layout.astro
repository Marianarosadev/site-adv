---
import '../styles/global.css';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import newsreaderFont from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site, whatsappLink, instagramLink, areas, areaUrl } from '../data/site';
import LineIcon from '../components/LineIcon.astro';
import InstagramSection from '../components/InstagramSection.astro';
import ContactSection from '../components/ContactSection.astro';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  // landing: página de destino de anúncio, sem menu de seções e com rodapé enxuto.
  variant?: 'default' | 'landing';
  // Mensagem e público dos botões fixos (cabeçalho, rodapé e flutuante).
  whatsapp?: string;
  tema?: string;
  publico?: 'trabalhador' | 'empresa' | 'geral';
  // Imagem de compartilhamento (WhatsApp, redes). Sem ela, usa a imagem padrão do site.
  ogImage?: string;
  // Artigos do blog: og:type "article" com as datas de publicação e atualização (ISO 8601).
  article?: { published: string; modified: string };
  // Páginas que não devem ir para o Google (ex.: 404): noindex e sem canonical.
  noindex?: boolean;
  // Título e texto da seção de contato do fim da página (o padrão serve para a maioria das páginas).
  contato?: { title?: string; soft?: string; intro?: string };
  // Landing pages focadas em conversão (ex.: /empresas/) podem esconder o Instagram do fim padrão.
  instagram?: boolean;
  // Páginas longas (ex.: /empresas/): barra de leitura no cabeçalho e o nome da seção atual sob o nome da advogada.
  // A página marca as seções com data-secao e cuida da atualização (ver o script de /empresas/).
  leitura?: boolean;
}

const {
  title, description, schema = [], variant = 'default', whatsapp = whatsappLink(), tema, publico = 'geral',
  ogImage: ogImagePath = '/og-image.jpg', contato = {}, article, noindex = false, instagram = true, leitura = false,
} = Astro.props;
const landing = variant === 'landing';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
const home = Astro.url.pathname === '/' ? '' : '/';
const blogPage = Astro.url.pathname.startsWith('/blog');
const empresasPage = Astro.url.pathname.startsWith('/empresas');
const gtm = site.gtmId;
// Build de homologação (SITE_ENV=homologacao no painel da Cloudflare): páginas marcadas para não serem indexadas.
const homologacao = process.env.SITE_ENV === 'homologacao';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {homologacao && <meta name="robots" content="noindex, nofollow" />}
    {noindex && !homologacao && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f7eeeb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={newsreaderFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin />

    <!-- Modo de Consentimento v2: tudo negado até a pessoa aceitar no banner. Precisa vir antes de qualquer tag. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied',
        wait_for_update: 500,
      });
      window.applyConsent = function (choice) {
        var v = choice === 'granted' ? 'granted' : 'denied';
        gtag('consent', 'update', { ad_storage: v, ad_user_data: v, ad_personalization: v, analytics_storage: v });
      };
      try {
        var saved = localStorage.getItem('consentimento-cookies');
        if (saved) window.applyConsent(saved);
      } catch (e) {}
    </script>
    <!-- O GTM só carrega no domínio oficial: homologação, prévias e localhost não entram nos relatórios do GA4 -->
    {gtm && (
      <script is:inline define:vars={{ gtm, prodHost: new URL(Astro.site).hostname }}>
        var host = location.hostname.replace(/^www\./, '');
        if (host === prodHost) (function (w, d, s, l, i) {
          w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtm);
      </script>
    )}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {schema.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    {gtm && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class:list={['header', { 'header--landing': landing, 'header--leitura': leitura }]} data-header>
      {leitura && <span class="header__progress" data-progress aria-hidden="true"></span>}
      <div class="container header__inner">
        <a class="brand" href={landing ? '/' : `${home}#topo`} aria-label={`${site.fullName}, página inicial`}>
          <span class="brand__mark" aria-hidden="true"><span class="mono-g">G</span><span class="mono-c">C</span><span class="mono-g mono-g--over">G</span></span>
          <span>
            <span class="brand__name">Giovanna Cabral</span>
            <span class="brand__role">{landing ? `Advogada · ${site.oab}` : 'Advocacia Trabalhista'}</span>
            {leitura && <span class="brand__where" data-where aria-hidden="true"></span>}
          </span>
        </a>
        {!landing && (
          <nav class="nav" aria-label="Seções">
            <a href={`${home}#como-posso-ajudar`}>Para trabalhadores</a>
            <a href={`${home}#sobre`}>Sobre</a>
            <a class="nav__blog" href="/blog/" aria-current={blogPage ? 'page' : undefined}><Icon name="book" /> Blog</a>
            <a class="nav__empresas" href="/empresas/" aria-current={empresasPage ? 'page' : undefined}><Icon name="building" /> Para empresas</a>
          </nav>
        )}
        <div class="header__actions">
          {!landing && (
            <a class="ig-btn" href={instagramLink} target="_blank" rel="noopener" aria-label={`Instagram @${site.instagram}`} data-local="cabecalho-instagram">
              <LineIcon name="instagram" />
            </a>
          )}
          <Button href={whatsapp} icon="whatsapp" local="cabecalho" tema={tema} publico={publico}>
            <span class="btn__label-long">Falar no WhatsApp</span><span class="btn__label-short">WhatsApp</span>
          </Button>
          {!landing && (
            <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu-celular" aria-label="Abrir menu" data-menu-btn>
              <span></span><span></span><span></span>
            </button>
          )}
        </div>
      </div>

      {!landing && (
        <nav class="mnav" id="menu-celular" aria-label="Menu" data-menu hidden>
          <div class="container mnav__inner">
            <!-- Só o essencial: as mesmas entradas do menu do computador, mais as dúvidas; empresas à parte -->
            <ul class="mnav__main">
              <li><a href={`${home}#como-posso-ajudar`}><Icon name="user" /><span>Para trabalhadores</span><Icon name="chevron-right" /></a></li>
              <li><a href={`${home}#sobre`}><Icon name="briefcase" /><span>Sobre a advogada</span><Icon name="chevron-right" /></a></li>
              <li><a href={`${home}#duvidas`}><Icon name="check" /><span>Perguntas frequentes</span><Icon name="chevron-right" /></a></li>
              <li><a class="mnav__blog" href="/blog/"><Icon name="book" /><span>Blog</span><Icon name="chevron-right" /></a></li>
            </ul>
            <a class="mnav__empresas" href="/empresas/">
              <Icon name="building" />
              <span><strong>Para empresas</strong><small>Advocacia preventiva e defesa em processos</small></span>
              <Icon name="chevron-right" />
            </a>
            <a class="insta-link mnav__social" href={instagramLink} target="_blank" rel="noopener" data-local="menu-instagram">
              <LineIcon name="instagram" /><span>Acompanhe no Instagram · @{site.instagram}</span>
            </a>
          </div>
        </nav>
      )}
    </header>

    <main id="conteudo">
      <slot />

      <!-- Fim padrão de todas as páginas: Instagram e contato, logo antes do rodapé.
           A faixa do monograma fixo cobre o Instagram e o que a página puser no slot "antes-do-fim" (na home, as dúvidas). -->
      <div class="monogram-zone">
        <div class="monogram-bg" aria-hidden="true">
          <span class="brand__mark monogram-bg__mark"><span class="mono-g">G</span><span class="mono-c">C</span><span class="mono-g mono-g--over">G</span></span>
        </div>
        <slot name="antes-do-fim" />
        {instagram && <InstagramSection />}
      </div>
      <ContactSection whatsapp={whatsapp} tema={tema} publico={publico} {...contato} />
    </main>

    <footer class:list={['footer', { 'footer--landing': landing }]}>
      {!landing && (
        <div class="container footer__top">
          <div>
            <p class="footer__call">Fale direto com a advogada.</p>
            <a class="footer__phone" href={whatsapp} target="_blank" rel="noopener" data-local="rodape" data-tema={tema} data-publico={publico}>{site.phoneShort}</a>
            <p class="footer__call">WhatsApp · {site.hours.toLowerCase()}</p>
            <a class="footer__social" href={instagramLink} target="_blank" rel="noopener" data-local="rodape-instagram">
              <LineIcon name="instagram" /><span>@{site.instagram}</span>
            </a>
          </div>
          <div class="footer__cols">
            <div>
              <h2>Atendimento</h2>
              <p>Online<br />{site.city} e todo o Brasil</p>
              <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
            </div>
            <div>
              <h2>Áreas</h2>
              <ul>
                {areas.slice(0, 5).map((area) => (
                  <li><a href={areaUrl(area.slug)}>{area.title}</a></li>
                ))}
              </ul>
            </div>
            <div>
              <h2>Site</h2>
              <ul>
                <li><a href={`${home}#sobre`}>Sobre</a></li>
                <li><a href={`${home}#como-funciona`}>Como funciona</a></li>
                <li><a href={`${home}#duvidas`}>Dúvidas</a></li>
                <li><a href="/empresas/">Para empresas</a></li>
                <li><a href="/blog/">Artigos</a></li>
                <li><a href="/politica-de-privacidade/">Política de privacidade</a></li>
              </ul>
            </div>
          </div>
        </div>
      )}
      <div class="container footer__legal">
        <p>
          {site.fullName}, Advogada, {site.oab}. Conteúdo de caráter exclusivamente informativo, que não constitui
          consultoria jurídica. O envio de mensagem não cria relação de contratação. Não envie documentos ou
          informações sigilosas antes do primeiro retorno.
        </p>
        <div class="footer__bottom">
          <span>© {new Date().getFullYear()} Dra. Giovanna Cabral</span>
          {landing && <a href="/">Página inicial</a>}
          <a href="/politica-de-privacidade/">Política de privacidade</a>
          <button type="button" class="footer__link-btn" data-cookie-prefs>Preferências de cookies</button>
        </div>
      </div>
      {!landing && <div class="footer__watermark" aria-hidden="true"><span class="brand__mark footer__monogram"><span class="mono-g">G</span><span class="mono-c">C</span><span class="mono-g mono-g--over">G</span></span></div>}
    </footer>

    <a
      class:list={['wa-float', { 'is-visible': landing }]}
      href={whatsapp}
      target="_blank"
      rel="noopener"
      aria-label="Conversar com a Dra. Giovanna pelo WhatsApp"
      data-wa-float
      data-local="flutuante"
      data-tema={tema}
      data-publico={publico}
    >
      <Icon name="whatsapp" />
    </a>

    <CookieBanner />

    <script>
      const header = document.querySelector('[data-header]');
      const float = document.querySelector('[data-wa-float]');
      const hero = document.querySelector('[data-hero]');

      // Menu do celular: abre e fecha pelo botão, fecha com Esc e ao escolher um link.
      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      const setMenu = (open: boolean) => {
        if (!menuBtn || !menu) return;
        menu.hidden = !open;
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
        document.documentElement.classList.toggle('menu-open', open);
      };
      menuBtn?.addEventListener('click', () => setMenu(menu?.hidden ?? false));
      menu?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) setMenu(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu && !menu.hidden) { setMenu(false); menuBtn?.focus(); }
      });

      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // O botão flutuante aparece depois que o topo sai da tela (ou sempre, em páginas sem topo e de anúncio).
      if (hero && float && !float.classList.contains('is-visible')) {
        new IntersectionObserver(([entry]) => float.classList.toggle('is-visible', !entry.isIntersecting), {
          rootMargin: '-120px 0px 0px 0px',
        }).observe(hero);
      } else {
        float?.classList.add('is-visible');
      }

      const reveals = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        }
      }, { rootMargin: '0px 0px -8% 0px' });
      reveals.forEach((el) => revealObserver.observe(el));
    </script>

    <script>
      // Origem "Google": na chegada por anúncio (gclid/gbraid/wbraid ou utm_source=google), a sessão é marcada
      // e todas as mensagens de WhatsApp passam a começar com "Vim pelo Google e…".
      const KEY = 'origem-visita';
      const params = new URLSearchParams(location.search);
      const fromAds = ['gclid', 'gbraid', 'wbraid'].some((p) => params.has(p)) || params.get('utm_source') === 'google';
      try {
        if (fromAds) sessionStorage.setItem(KEY, 'google');
      } catch {}
      let origin: string | null = fromAds ? 'google' : null;
      try { origin ??= sessionStorage.getItem(KEY); } catch {}

      if (origin === 'google') {
        document.querySelectorAll<HTMLAnchorElement>('a[href*="wa.me/"]').forEach((a) => {
          const url = new URL(a.href);
          const text = url.searchParams.get('text');
          if (!text) return;
          url.searchParams.set('text', text.replace('Vim pelo site e', 'Vim pelo Google e'));
          a.href = url.toString();
        });
      }

      // Medição: cada clique em WhatsApp ou telefone vira um evento no dataLayer, lido pelo GTM.
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="wa.me/"], a[href^="tel:"]');
        if (!link) return;
        const w = window as unknown as { dataLayer: object[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({
          event: link.href.startsWith('tel:') ? 'phone_click' : 'whatsapp_click',
          local: link.dataset.local ?? 'outro',
          tema: link.dataset.tema ?? 'geral',
          publico: link.dataset.publico ?? 'geral',
        });
      });
    </script>
  </body>
</html>
