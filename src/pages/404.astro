---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { areas, areaUrl } from '../data/site';

// Servida pela Cloudflare com status 404 para qualquer endereço que não existe (not_found_handling em wrangler.jsonc).
---
<Layout
  title="Página não encontrada | Giovanna Cabral"
  description="O endereço acessado não existe. Veja os temas de Direito do Trabalho atendidos pela Dra. Giovanna Cabral ou fale pelo WhatsApp."
  noindex
>
  <section class="page">
    <div class="container prose">
      <p class="eyebrow">Erro 404</p>
      <h1>Esta página não existe.</h1>
      <p>
        O link pode estar errado ou a página mudou de endereço. Veja abaixo os temas em que posso ajudar, ou volte à
        página inicial.
      </p>
      <ul>
        {areas.map((area) => <li><a href={areaUrl(area.slug)}>{area.title}</a></li>)}
        <li><a href="/blog/">Artigos sobre Direito do Trabalho</a></li>
        <li><a href="/empresas/">Atendimento para empresas</a></li>
      </ul>
      <p><Button href="/">Ir para a página inicial</Button></p>
    </div>
  </section>
</Layout>
