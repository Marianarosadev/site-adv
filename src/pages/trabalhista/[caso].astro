---
import CasePage from '../../components/CasePage.astro';
import { whatsappLink, areaUrl } from '../../data/site';
import { casos, type Caso } from '../../data/casos';
import { getPostsByTopic } from '../../data/blog';

export function getStaticPaths() {
  return casos.map((caso) => ({ params: { caso: caso.slug }, props: { caso } }));
}

const { caso } = Astro.props as { caso: Caso };
const wa = whatsappLink(caso.message);
const tema = caso.slug;
const related = await getPostsByTopic(caso.slug);
// "Horas extras" vira "horas extras", mas siglas como "FGTS" e "PJ" ficam em maiúsculas.
const topicName = /^[A-ZÀ-Ú][a-zà-ú]/.test(caso.title) ? caso.title[0].toLowerCase() + caso.title.slice(1) : caso.title;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: caso.faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Como posso ajudar', item: new URL('/#como-posso-ajudar', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: caso.title, item: new URL(areaUrl(caso.slug), Astro.site).href },
    ],
  },
];
---
<CasePage
  layout={{
    title: `${caso.seoTitle} | Giovanna Cabral`,
    description: caso.description,
    schema,
    whatsapp: wa,
    tema,
    publico: 'trabalhador',
    contato: { intro: 'Me conte o que aconteceu. Para começar, você não precisa ter todos os documentos em mãos.' },
  }}
  slug={caso.slug}
  crumbs={[{ label: 'Início', href: '/' }, { label: 'Como posso ajudar', href: '/#como-posso-ajudar' }, { label: caso.title }]}
  h1={caso.h1}
  quote={caso.quote}
  intro={caso.intro}
  photo={caso.photo}
  local="caso"
  cta="Conversar sobre isso"
  what={caso.what}
  when={{ title: ['Quando você', 'pode pedir.'], items: caso.when, note: 'Se você se identificou com algum desses pontos, vale conversar sobre o seu caso.' }}
  rights={{
    title: caso.rightsTitle ?? ['O que pode', 'ser reconhecido.'],
    intro: 'Cada caso depende dos fatos e das provas. Estes são os direitos que a lei prevê.',
    items: caso.rights,
  }}
  proof={{ title: ['Provas', 'que ajudam.'], items: caso.proof }}
  deadlines={{ title: ['Prazos', 'importantes.'], items: caso.deadlines }}
  faq={caso.faq}
  related={related}
  topic={topicName}
/>
