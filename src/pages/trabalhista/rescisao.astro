---
import CasePage from '../../components/CasePage.astro';
// Foto de Gabrielle Henderson na Unsplash (licença de uso livre).
import fotoRescisao from '../../assets/casos/rescisao.jpg';
import { getPostsByTopic } from '../../data/blog';
import { whatsappLink } from '../../data/site';
import { situations, checks, documents, deadlines, rescisaoFaq } from '../../data/rescisao';

const wa = whatsappLink('tenho dúvidas sobre a minha rescisão.');
const tema = 'rescisao';
const related = await getPostsByTopic('rescisao');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: rescisaoFaq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Rescisão trabalhista', item: new URL('/trabalhista/rescisao/', Astro.site).href },
    ],
  },
];
---
<CasePage
  layout={{
    title: 'Advogada de Rescisão Trabalhista em Goiânia | Giovanna Cabral',
    description: 'Fui demitido e acho que não recebi tudo. Advogada trabalhista em Goiânia confere as verbas, os prazos e a multa do FGTS da sua rescisão. Atendimento online.',
    schema,
    variant: 'landing',
    whatsapp: wa,
    tema,
    publico: 'trabalhador',
    contato: { title: 'Tire sua dúvida', soft: 'no WhatsApp.', intro: 'Me conte como foi a sua saída e o que você recebeu. Para começar, você não precisa ter todos os documentos em mãos.' },
  }}
  slug={tema}
  h1={['Rescisão trabalhista:', 'advogada com atendimento online.']}
  quote="Fui demitido e acho que não recebi tudo."
  intro="Eu confiro cada verba da sua rescisão, os prazos de pagamento e a multa do FGTS, e explico com clareza o que foi pago e o que pode estar faltando."
  photo={{ src: fotoRescisao, alt: 'Pessoa assinando documentos sobre uma mesa', credit: 'Gabrielle Henderson' }}
  local="lp"
  cta="Tirar minha dúvida no WhatsApp"
  when={{ title: ['Isso aconteceu', 'com você?'], items: situations, note: 'Esta página é para quem trabalhou com carteira assinada, sem registro ou como PJ.' }}
  rights={{
    title: ['O que eu confiro', 'na sua rescisão.'],
    intro: 'Os itens variam conforme o tipo de saída: dispensa, pedido de demissão, justa causa ou acordo.',
    items: checks,
  }}
  proof={{ title: ['Documentos', 'que ajudam.'], items: documents }}
  deadlines={{ title: ['Os prazos', 'que a lei prevê.'], items: deadlines }}
  faq={rescisaoFaq}
  related={related}
  topic="rescisão"
  others={false}
/>
