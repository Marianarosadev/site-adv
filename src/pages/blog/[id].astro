---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import PostCard from '../../components/PostCard.astro';
import fotoPerfil from '../../assets/giovanna-perfil.jpg';
import { site, whatsappLink, whatsappEmpresa, telLink, instagramLink } from '../../data/site';
import LineIcon from '../../components/LineIcon.astro';
import { getPosts, postUrl, readingTime, formatDate, categorySlug, type Post } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props as { post: Post; posts: Post[] };
const { Content } = await render(post);
const { title, description, date, updated, category, audience, cover } = post.data;
const empresa = audience === 'empresa';
// Prévia do link no WhatsApp e nas redes: a foto do artigo, no formato 1200x630.
const ogImage = cover
  ? (await getImage({ src: cover.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : undefined;
const publico = empresa ? 'empresa' : 'trabalhador';
const wa = empresa
  ? whatsappEmpresa(`Li o artigo "${title}" e gostaria de conversar.`)
  : whatsappLink(`li o artigo "${title}" e gostaria de uma orientação.`);

// Relacionados: primeiro os do mesmo tema, depois os mais recentes.
const related = [
  ...posts.filter((p) => p.id !== post.id && p.data.category === category),
  ...posts.filter((p) => p.id !== post.id && p.data.category !== category),
].slice(0, 3);

const url = new URL(postUrl(post), Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    url,
    mainEntityOfPage: url,
    image: new URL(ogImage ?? '/og-image.jpg', Astro.site).href,
    author: { '@type': 'Person', name: site.fullName, jobTitle: 'Advogada trabalhista', identifier: site.oab },
    publisher: { '@type': 'Person', name: site.fullName },
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Artigos', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---
<Layout
  title={`${title} | Dra. Giovanna Cabral`}
  description={description}
  schema={schema}
  whatsapp={wa}
  tema={`blog-${post.id}`}
  publico={publico}
  ogImage={ogImage}
>
  <article class="article">
    <header class="container article__head">
      <nav class="crumbs" aria-label="Você está em">
        <a href="/">Início</a> <span aria-hidden="true">/</span> <a href="/blog/">Artigos</a>
        <span aria-hidden="true">/</span> <a href={`/blog/?tema=${categorySlug(category)}`}>{category}</a>
      </nav>
      <h1 class="article__title">{title}</h1>
      <p class="article__lead">{description}</p>
      <div class="article__byline">
        <Picture src={fotoPerfil} alt="" widths={[88]} sizes="44px" formats={['avif', 'webp']} loading="eager" />
        <span>
          <strong>{site.fullName}</strong> · {site.oab}<br />
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <> · atualizado em <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
          {' · '}{readingTime(post)}
        </span>
      </div>
    </header>

    {cover && (
      <figure class="container article__cover">
        <Picture
          src={cover.src}
          alt={cover.alt}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1184px) 1120px, calc(100vw - 32px)"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>Imagem ilustrativa · Foto: {cover.credit} / Unsplash</figcaption>
      </figure>
    )}

    <div class="container">
      <div class="article__body prose">
        <Content />
      </div>

      <aside class="article__cta" aria-label="Fale comigo">
        <h2>Ficou com alguma dúvida sobre o {empresa ? 'caso da empresa' : 'seu caso'}?</h2>
        <p>Me conte o que aconteceu pelo WhatsApp ou por telefone. Cada situação tem particularidades.</p>
        <div class="hero__actions">
          <Button href={wa} icon="whatsapp" local="artigo" tema={`blog-${post.id}`} publico={publico}>Falar no WhatsApp</Button>
          <Button href={telLink} icon="phone" local="artigo" tema={`blog-${post.id}`} publico={publico}>Ligar</Button>
        </div>
        <a class="insta-link article__social" href={instagramLink} target="_blank" rel="noopener" data-local="artigo-instagram">
          <LineIcon name="instagram" /><span>Mais conteúdos como este no Instagram · @{site.instagram}</span>
        </a>
      </aside>

      <p class="article__disclaimer">
        Conteúdo de caráter exclusivamente informativo, que não substitui a análise de um caso concreto nem constitui
        consultoria jurídica.
      </p>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--tight" aria-labelledby="relacionados">
      <div class="container">
        <div class="section-head">
          <h2 class="display display--md" id="relacionados">Leia <span class="soft">também.</span></h2>
          <a class="link-arrow" href="/blog/">Ver todos os artigos</a>
        </div>
        <ul class="posts posts--filtered">
          {related.map((p) => <PostCard post={p} />)}
        </ul>
      </div>
    </section>
  )}
</Layout>
