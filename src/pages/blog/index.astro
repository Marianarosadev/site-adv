---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import PostCover from '../../components/PostCover.astro';
import fotoPerfil from '../../assets/giovanna-perfil.jpg';
import { site, whatsappLink, instagramLink } from '../../data/site';
import LineIcon from '../../components/LineIcon.astro';
import { getPosts, categories, categorySlug, postUrl, readingTime, formatDate } from '../../data/blog';

const posts = await getPosts();
const [featured] = posts;
// Só mostra no filtro e na lateral os temas que têm artigo publicado.
// Data em duas linhas na lista: o dia grande e, embaixo, mês e ano ("nov. 2026").
const day = (d: Date) => String(d.getUTCDate()).padStart(2, '0');
const monthYear = (d: Date) => `${d.toLocaleDateString('pt-BR', { month: 'short', timeZone: 'UTC' })} ${d.getUTCFullYear()}`;
const used = categories
  .map((c) => ({ name: c, slug: categorySlug(c), count: posts.filter((p) => p.data.category === c).length }))
  .filter((c) => c.count > 0);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: `Artigos | ${site.fullName}`,
    url: new URL('/blog/', Astro.site).href,
    author: { '@type': 'Person', name: site.fullName, identifier: site.oab },
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      url: new URL(postUrl(p), Astro.site).href,
      datePublished: p.data.date.toISOString(),
    })),
  },
];
---
<Layout
  title="Blog de Direito do Trabalho | Giovanna Cabral"
  description="Blog com artigos e orientações claras sobre rescisão, horas extras, vínculo de emprego e outros temas do Direito do Trabalho, para trabalhadores e empresas."
  schema={schema}
>
  <!-- Topo: a foto do artigo mais recente ao fundo, sob o véu vinho dos artigos; à esquerda o nome do blog,
       à direita (embaixo, no celular) o artigo mais recente em destaque -->
  <header class:list={['blog-top', { 'blog-top--plain': !featured?.data.cover }]}>
    {featured?.data.cover && (
      <div class="blog-top__bg" aria-hidden="true">
        <Picture src={featured.data.cover.src} alt="" widths={[640, 1000, 1600]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
      </div>
    )}
    <div class="container blog-top__grid">
      <div>
        <p class="blog-top__kicker"><Icon name="book" />Blog · {posts.length} {posts.length === 1 ? 'artigo publicado' : 'artigos publicados'}</p>
        <h1 class="blog-top__title">Artigos <em>sobre os seus direitos no trabalho.</em></h1>
        <p class="blog-top__intro">
          Textos curtos, em linguagem simples, sobre as dúvidas que mais aparecem no dia a dia de quem trabalha e de
          quem emprega.
        </p>
        <p class="blog-top__byline">
          <Picture src={fotoPerfil} alt="" widths={[80]} sizes="40px" formats={['avif', 'webp']} loading="eager" />
          <span>Escritos por <strong>{site.fullName}</strong> · {site.oab}</span>
        </p>
      </div>
      {featured && (
        <a class="blog-top__featured" href={postUrl(featured)}>
          <span class="blog-top__label">Mais recente · {featured.data.category}</span>
          <span class="blog-top__ftitle">{featured.data.title}</span>
          <span class="blog-top__meta">
            <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time> · {readingTime(featured)}
          </span>
          <span class="blog-top__read">Ler artigo <Icon name="arrow" /></span>
        </a>
      )}
    </div>
  </header>

  <!-- Temas: abas sublinhadas que ficam presas sob o cabeçalho; o tema escolhido vai para o endereço (?tema=) -->
  {posts.length > 0 && (
    <nav class="blog-tabs" aria-label="Filtrar por tema">
      <div class="container">
        <div class="blog-tabs__row" data-blog-filter>
          <button type="button" aria-pressed="true" data-filter="todos">Todos <sup>{posts.length}</sup></button>
          {used.map((c) => (
            <button type="button" aria-pressed="false" data-filter={c.slug} data-cat={c.slug} data-name={c.name}>
              {c.name} <sup>{c.count}</sup>
            </button>
          ))}
        </div>
      </div>
    </nav>
  )}

  <section class="blog-body">
    <div class="container blog-layout">
      <div class="blog-main">
        {posts.length === 0 ? (
          <p class="muted">Nenhum artigo publicado ainda.</p>
        ) : (
          <>
            <h2 class="blog-list-title" data-list-title>Todos os artigos</h2>
            <!-- Índice editorial: data à esquerda, o texto no meio e a capa pequena à direita -->
            <ol class="blog-feed" data-posts>
              {posts.map((post, i) => (
                <li
                  class:list={['blog-item', { 'is-featured': i === 0 }]}
                  data-category={categorySlug(post.data.category)}
                >
                  <a href={postUrl(post)} class="blog-item__link">
                    <time class="blog-item__date" datetime={post.data.date.toISOString()}>
                      <span>{day(post.data.date)}</span>{monthYear(post.data.date)}
                    </time>
                    <div class="blog-item__body">
                      <p class="blog-item__cat" data-cat={categorySlug(post.data.category)}>{post.data.category}</p>
                      <h3 class="blog-item__title">{post.data.title}</h3>
                      <p class="blog-item__excerpt">{post.data.description}</p>
                      <p class="blog-item__meta">{readingTime(post)} <span class="blog-item__read">Ler artigo <Icon name="arrow" /></span></p>
                    </div>
                    <PostCover category={post.data.category} cover={post.data.cover} sizes="(min-width: 760px) 220px, 100vw" class="blog-item__cover" />
                  </a>
                </li>
              ))}
            </ol>
            <p class="muted blog-empty" data-blog-empty hidden>Nenhum artigo neste tema ainda.</p>
          </>
        )}
      </div>

      <!-- Lateral: quem escreve e o contato, sem caixas, separados por filetes -->
      <aside class="blog-aside" aria-label="Sobre o blog">
        <div class="blog-aside__block">
          <Picture src={fotoPerfil} alt="Dra. Giovanna Cabral" widths={[160]} sizes="72px" formats={['avif', 'webp']} />
          <p class="blog-aside__label">Quem escreve</p>
          <h2 class="blog-aside__name">{site.fullName}</h2>
          <p class="blog-aside__role">Advogada trabalhista · {site.oab}</p>
          <p class="blog-aside__text">{site.title}. Escrevo para explicar, sem "juridiquês", o que a lei diz sobre o trabalho.</p>
          <a class="link-arrow" href="/#sobre">Conheça minha trajetória</a>
          <a class="blog-aside__social" href={instagramLink} target="_blank" rel="noopener" data-local="blog-instagram">
            <LineIcon name="instagram" /><span>@{site.instagram}</span>
          </a>
        </div>
        <div class="blog-aside__block">
          <p class="blog-aside__label">Tem uma dúvida específica?</p>
          <p class="blog-aside__text">Cada caso tem particularidades. Me conte o que aconteceu.</p>
          <a
            class="btn btn--whatsapp btn--block"
            href={whatsappLink('li os artigos do blog e gostaria de uma orientação.')}
            target="_blank"
            rel="noopener"
            data-local="blog-lateral"
            data-tema="blog"
          >
            <Icon name="whatsapp" /><span>Falar no WhatsApp</span>
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  // Filtro por tema no próprio navegador; o tema escolhido vai para o endereço (?tema=) para poder ser compartilhado.
  const filter = document.querySelector<HTMLElement>('[data-blog-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-posts] > li');
  const listTitle = document.querySelector<HTMLElement>('[data-list-title]');
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');

  function apply(slug: string, scroll = false) {
    const all = slug === 'todos';
    let shown = 0;
    filter?.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.filter === slug)),
    );
    // Na lista completa o mais recente fica só no destaque do topo; filtrando, ele aparece na lista do tema.
    items.forEach((item) => {
      const visible = all ? !item.classList.contains('is-featured') : item.dataset.category === slug;
      item.hidden = !visible;
      if (visible || (all && item.classList.contains('is-featured'))) shown++;
    });
    if (listTitle) {
      const label = filter?.querySelector<HTMLElement>(`[data-filter="${CSS.escape(slug)}"]`)?.dataset.name;
      listTitle.textContent = all ? 'Todos os artigos' : `Artigos sobre ${label}`;
    }
    if (empty) empty.hidden = shown > 0;
    // Com as abas presas no alto, a lista volta ao começo para mostrar o primeiro artigo do tema
    if (scroll && listTitle && listTitle.getBoundingClientRect().top < 0) listTitle.scrollIntoView({ block: 'start' });
  }

  function select(slug: string, scroll = false) {
    apply(slug, scroll);
    const url = new URL(location.href);
    if (slug === 'todos') url.searchParams.delete('tema'); else url.searchParams.set('tema', slug);
    history.replaceState(null, '', url);
  }

  const initial = new URLSearchParams(location.search).get('tema');
  apply(initial && filter?.querySelector(`[data-filter="${CSS.escape(initial)}"]`) ? initial : 'todos');

  filter?.addEventListener('click', (event) => {
    const slug = (event.target as HTMLElement).closest<HTMLElement>('[data-filter]')?.dataset.filter;
    if (slug) select(slug, true);
  });
</script>
