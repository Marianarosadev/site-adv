---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import LineIcon from '../components/LineIcon.astro';
import fotoPerfil from '../assets/giovanna-perfil.jpg';
// Foto de Michael Fousert na Unsplash (licença Unsplash, uso livre): unsplash.com/photos/RNsKphkdBTk
import fotoReuniao from '../assets/empresas-reuniao.jpg';
import { site, whatsappEmpresa, servicesEmpresa, type LineIconName } from '../data/site';

// Versão enxuta (decisão A2): a página não recebe anúncio no 1º mês.
const wa = whatsappEmpresa();
const pad = (n: number) => String(n).padStart(2, '0');

const moments: { title: string; text: string; icon: LineIconName }[] = [
  { icon: 'scroll-text', title: 'A empresa recebeu uma notificação', text: 'Chegou a citação de uma reclamação trabalhista e é preciso preparar a defesa no prazo.' },
  { icon: 'calendar-clock', title: 'Há uma audiência marcada', text: 'A empresa e o preposto precisam chegar preparados, com os documentos certos.' },
  { icon: 'handshake', title: 'Existe uma proposta de acordo', text: 'Antes de aceitar ou propor um valor, vale entender os riscos e as alternativas.' },
];

const stepsEmpresa = [
  { title: 'Você me chama no WhatsApp', text: 'Conte o que a empresa recebeu e, se houver, a data da audiência.' },
  { title: 'Analiso os documentos', text: 'Leio a reclamação e indico o que reunir para a defesa.' },
  { title: 'Explico os caminhos', text: 'Defesa, acordo ou outra estratégia: você decide com informação clara.' },
  { title: 'Acompanho até o fim', text: 'Contrato por escrito, assinado digitalmente, e retorno sobre cada etapa.' },
];

// O serviço aponta para o escritório descrito na home (mesmo @id), com os dados básicos repetidos para validar sozinho.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Advocacia trabalhista para empresas',
    serviceType: 'Advocacia trabalhista empresarial',
    description: 'Defesa de empresas em reclamações trabalhistas, preparação de preposto, audiências, acordos e orientação preventiva.',
    url: new URL('/empresas/', Astro.site).href,
    provider: {
      '@type': ['LegalService', 'Attorney'],
      '@id': new URL('/#escritorio', Astro.site).href,
      name: `${site.fullName}, Advogada Trabalhista`,
      url: Astro.site?.href,
      telephone: site.phoneE164,
      identifier: site.oab,
    },
    areaServed: [
      { '@type': 'City', name: 'Goiânia' },
      { '@type': 'State', name: 'Goiás' },
      { '@type': 'Country', name: 'Brasil' },
    ],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Serviços para empresas',
      itemListElement: servicesEmpresa.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.title, description: s.text },
      })),
    },
  },
];
---
<Layout
  title="Advocacia Trabalhista para Empresas em Goiânia | Giovanna Cabral"
  description="Defesa de empresas em reclamações trabalhistas, audiências e acordos. Advogada trabalhista em Goiânia, com atendimento online em todo o Brasil."
  schema={schema}
  whatsapp={wa}
  publico="empresa"
  contato={{ soft: 'sobre o caso da empresa.', intro: 'Me conte o que a empresa recebeu. Se houver audiência marcada, informe a data na primeira mensagem.' }}
>
  <section class="lp-hero lp-hero--empresa">
    <div class="lp-hero__bg" aria-hidden="true">
      <Picture src={fotoReuniao} alt="" widths={[640, 1200, 1600]} sizes="100vw" formats={['avif', 'webp']} loading="eager" />
    </div>
    <div class="container lp-hero__inner">
      <p class="eyebrow eyebrow--pill">Para empresas · Goiânia e online</p>
      <h1 class="display display--inline display--lp">Advocacia trabalhista <span class="soft">para empresas.</span></h1>
      <p class="lp-hero__intro">
        Acompanhamento preventivo contínuo, para evitar conflitos na rotina, e defesa da empresa na Justiça do
        Trabalho quando o processo chega, com orientação clara em cada decisão.
      </p>
      <div class="hero__actions">
        <Button href={wa} icon="whatsapp" local="empresas-topo" publico="empresa">Falar no WhatsApp</Button>
      </div>
      <div class="cred">
        <Picture src={fotoPerfil} alt="" widths={[88]} sizes="44px" formats={['avif', 'webp']} loading="eager" />
        <span><strong>{site.fullName}</strong> · {site.oab}<br />{site.title}</span>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2 class="display display--inline display--md">Quando <span class="soft">me procurar.</span></h2>
      </div>
      <ul class="checks">
        {moments.map((m) => (
          <li class="check"><span class="check__mark" aria-hidden="true"><LineIcon name={m.icon} /></span><LineIcon name={m.icon} class="check__icon" /><h3>{m.title}</h3><p>{m.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2 class="display display--inline display--md">Como posso <span class="soft">ajudar a empresa.</span></h2>
      </div>
      <ul class="diffs">
        {servicesEmpresa.map((s) => (
          <li class="diff"><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <h2 class="display display--inline display--md">Como funciona <span class="soft">o atendimento.</span></h2>
      </div>
      <ol class="steps">
        {stepsEmpresa.map((s, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">{pad(i + 1)}</span>
            <div class="step__card">
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Layout>
