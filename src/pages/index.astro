---
import { Picture, getImage } from 'astro:assets';
import sharp from 'sharp';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import AreaIcon from '../components/AreaIcon.astro';
import LineIcon from '../components/LineIcon.astro';
import { getPosts, postUrl, readingTime } from '../data/blog';
import fotoTopo from '../assets/giovanna-topo.jpg';
import fotoPerfil from '../assets/giovanna-perfil.jpg';
import {
  site, areaUrl, whatsappLink, whatsappEmpresa, areas, stats, timeline, education, steps, differentials, faq,
  frentesEmpresa, instagramLink,
} from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
// Carrossel da home: até 8 artigos mais recentes.
const latestPosts = (await getPosts()).slice(0, 8);

// Foto do topo: mesmas opções no <Picture> e no preload, para o navegador baixar o arquivo certo o quanto antes.
const heroWidths = [640, 1000, 1086];
const heroSizes = '(min-width: 900px) 64vw, 100vw';
const heroPreload = await getImage({ src: fotoTopo, widths: heroWidths, sizes: heroSizes, format: 'avif' });
// Prévia minúscula (~1 KB) embutida no HTML: aparece desfocada na hora, enquanto a foto real carrega.
const heroPlaceholder = `data:image/webp;base64,${(
  await sharp('src/assets/giovanna-topo.jpg').resize(32).webp({ quality: 50 }).toBuffer()
).toString('base64')}`;
const shortcuts = [
  { label: 'Rescisão', hint: 'Recebi tudo?', id: 'area-rescisao', icon: 'receipt-text' },
  { label: 'Horas extras', hint: 'Jornada sem pagamento', id: 'area-horas-extras', icon: 'clock' },
  { label: 'Carteira não assinada', hint: 'Sem registro ou PJ', id: 'area-carteira-nao-assinada', icon: 'id-card' },
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    // Nome que o Google mostra acima do título nos resultados, no lugar do domínio.
    name: site.siteName,
    alternateName: site.name,
    url: Astro.site?.href,
    inLanguage: 'pt-BR',
    publisher: { '@id': new URL('/#escritorio', Astro.site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': ['LegalService', 'Attorney'],
    // Identificador usado pelo serviço de /empresas/ para apontar para este escritório.
    '@id': new URL('/#escritorio', Astro.site).href,
    name: `${site.fullName}, Advogada Trabalhista`,
    description: 'Advogada trabalhista em Goiânia, com atendimento online para trabalhadores e empresas em todo o Brasil.',
    url: Astro.site?.href,
    telephone: site.phoneE164,
    email: site.email,
    image: new URL('/og-image.jpg', Astro.site).href,
    identifier: site.oab,
    sameAs: [instagramLink],
    knowsAbout: ['Direito do Trabalho', 'Processo do Trabalho', ...areas.map((a) => a.title)],
    areaServed: [
      { '@type': 'City', name: 'Goiânia' },
      { '@type': 'City', name: 'Aparecida de Goiânia' },
      { '@type': 'City', name: 'Senador Canedo' },
      { '@type': 'State', name: 'Goiás' },
      { '@type': 'Country', name: 'Brasil' },
    ],
    availableLanguage: 'pt-BR',
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Layout
  title="Advogada Trabalhista em Goiânia | Giovanna Cabral"
  description="Advogada trabalhista em Goiânia, com atendimento online em todo o Brasil. Rescisão, horas extras, rescisão indireta e carteira não assinada. Atendo empresas."
  schema={schema}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes={heroSizes}
    fetchpriority="high"
  />

  <!-- 1. Topo -->
  <section class="hero" id="topo" data-hero>
    <div class="hero__bg">
      <div class="hero__placeholder" style={`background-image: url(${heroPlaceholder})`} aria-hidden="true"></div>
      <Picture
        src={fotoTopo}
        alt="Dra. Giovanna Cabral, advogada trabalhista, em seu escritório"
        widths={heroWidths}
        sizes={heroSizes}
        onload="this.classList.add('is-loaded')"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__watermark" aria-hidden="true">TRABALHO</div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow eyebrow--pill">Goiânia · Atendimento online para todo o Brasil</p>
        <h1 class="display display--hero">
          Advogada trabalhista em Goiânia, <span class="soft">com clareza em cada etapa.</span>
        </h1>
        <p class="hero__intro">
          Sou a <strong>Dra. Giovanna Cabral</strong>, {site.oab}. Atendimento 100% online, com linguagem clara do
          primeiro contato ao fim do processo.
        </p>

        <!-- Dois caminhos, um para cada público: cada um com uma frase e uma única ação -->
        <div class="paths">
          <div class="path path--trab">
            <p class="path__label"><Icon name="user" /> Para trabalhadores</p>
            <p class="path__text">Rescisão, horas extras, carteira não assinada e outros direitos.</p>
            <Button href={whatsappLink()} icon="whatsapp" local="topo-trabalhador" publico="trabalhador">Falar no WhatsApp</Button>
          </div>
          <div class="path path--emp">
            <p class="path__label"><Icon name="shield" /> Para empresas</p>
            <p class="path__text"><strong>Advocacia preventiva</strong>: contratos, rotinas e desligamentos.</p>
            <a class="btn btn--azul-ghost" href="/empresas/"><span>Conhecer o atendimento</span><Icon name="arrow" /></a>
          </div>
        </div>
      </div>

      <nav class="chips" aria-label="Temas mais procurados">
        <span class="chips__label" aria-hidden="true">Mais procurados</span>
        <!-- No celular os atalhos passam em loop: as cópias (escondidas de leitores de tela) fecham a emenda. -->
        <div class="chips__track">
          {[0, 1, 2, 3].map((copy) => shortcuts.map((s) => (
            <a
              class:list={['chip', { 'chip--clone': copy > 0 }]}
              href={`#${s.id}`}
              {...(copy > 0 ? { 'aria-hidden': 'true', tabindex: '-1' } : {})}
            >
              <AreaIcon name={s.icon} class="chip__icon" />
              <span class="chip__text">
                <strong>{s.label}</strong>
                <small>{s.hint}</small>
              </span>
              <Icon name="arrow" />
            </a>
          )))}
        </div>
      </nav>
    </div>
  </section>

  <!-- 2. Apresentação e números -->
  <section class="section section--intro" aria-label="Apresentação">
    <!-- Vídeo da advogada em reunião (sem som, em loop) parado na tela enquanto a frase
         passa por ele durante a rolagem -->
    <div class="container scrolly">
      <div class="scrolly__media" aria-hidden="true">
        <div class="scrolly__frame">
          <video
            class="scrolly__video"
            muted
            loop
            playsinline
            preload="none"
            poster="/video/escritorio-poster.jpg"
            data-bg-video
          >
            <source data-src="/video/escritorio.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
      <div class="scrolly__content">
        <div class="statement scrolly__step" data-step>
          <span class="statement__ornament" aria-hidden="true"><span></span></span>
          <p class="statement__text">
            Cada caso é analisado com atenção aos detalhes.{' '}
            <span class="soft">E cada etapa é explicada de forma simples, para você decidir com segurança.</span>
          </p>
          <!-- o ornamento se repete no fim, fechando a frase -->
          <span class="statement__ornament statement__ornament--end" aria-hidden="true"><span></span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2b. Destaques: quatro cartões logo abaixo do vídeo -->
  <section class="section section--highlights" aria-label="Diferenciais">
    <div class="container">
      <ul class="highlights reveal">
        {stats.map((s) => (
          <li class="highlight">
            <span class="highlight__mark" aria-hidden="true"><AreaIcon name={s.icon} /></span>
            <AreaIcon name={s.icon} class="highlight__icon" />
            <p class="highlight__title">{s.title}</p>
            <p class="highlight__text">{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Como posso ajudar -->
  <section class="section" id="como-posso-ajudar">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Como posso ajudar <span class="soft">no seu caso.</span></h2>
      </div>
      <!-- Cartões de tema: ícone, número, título e a frase na voz de quem procura. O cartão inteiro leva à página do tema;
           o WhatsApp fica num atalho discreto no rodapé do cartão. -->
      <ul class="topics">
        {areas.map((area) => (
          <li class="topic reveal" id={`area-${area.slug}`}>
            <span class="topic__mark" aria-hidden="true"><AreaIcon name={area.icon} /></span>
            <div class="topic__top">
              <AreaIcon name={area.icon} class="topic__icon" />
              <h3 class="topic__title"><a href={areaUrl(area.slug)}>{area.title}</a></h3>
            </div>
            <p class="topic__quote">“{area.situation}”</p>
            <p class="topic__text">{area.text}</p>
            <div class="topic__foot">
              <span class="topic__more" aria-hidden="true">Entenda seus direitos <Icon name="arrow" /></span>
              <a
                class="topic__wa"
                href={whatsappLink(area.message)}
                target="_blank"
                rel="noopener"
                aria-label={`Conversar sobre ${area.title.toLowerCase()} no WhatsApp`}
                title="Conversar no WhatsApp"
                data-local={`card-${area.slug}`}
                data-tema={area.slug}
                data-publico="trabalhador"
              >
                <Icon name="whatsapp" />
              </a>
            </div>
          </li>
        ))}
        <li class="topic topic--cta reveal">
          <div>
            <h3 class="topic__title">Não encontrou <span class="soft">a sua situação?</span></h3>
            <p class="topic__cta-text">Me conte o que aconteceu. Eu explico se e como o seu caso pode ser analisado.</p>
          </div>
          <Button href={whatsappLink()} icon="whatsapp" local="card-outro" publico="trabalhador">Tire sua dúvida pelo WhatsApp</Button>
        </li>
      </ul>
    </div>
  </section>

  <!-- 3b. Para empresas: faixa azul de ponta a ponta que entra como uma cortina, da direita, com a rolagem -->
  <section class="curtain" id="para-empresas" aria-labelledby="empresas-titulo" data-curtain>
    <span class="curtain__word" aria-hidden="true">Empresas</span>
    <div class="container curtain__grid">
      <div>
        <p class="curtain__kicker">Também atendo</p>
        <h2 class="curtain__title" id="empresas-titulo">Atendimento <em>para empresas.</em></h2>
        <p class="curtain__lead">Acompanhamento contínuo para prevenir conflitos e, quando o processo chega, a defesa da empresa em todas as fases.</p>
        <div class="curtain__actions">
          <Button href={whatsappEmpresa()} icon="whatsapp" local="faixa-empresas" publico="empresa">WhatsApp para empresas</Button>
          <a class="curtain__more" href="/empresas/">Conhecer o atendimento <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="curtain__fronts">
        {frentesEmpresa.map((f) => (
          <div class="curtain__front">
            <h3><Icon name={f.icon} />{f.title}</h3>
            <ul>
              {f.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Sobre -->
  <section class="section" id="sobre">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Prazer, <span class="soft">Dra. Giovanna Cabral.</span></h2>
      </div>
      <div class="about">
        <div class="about__photo reveal">
          <Picture
            src={fotoPerfil}
            alt="Retrato de perfil da advogada trabalhista Giovanna Cabral"
            widths={[480, 720, 1000]}
            sizes="(min-width: 900px) 460px, 100vw"
            formats={['avif', 'webp']}
          />
        </div>
        <div class="reveal">
          <p class="about__role">{site.fullName} · Advogada trabalhista · {site.oab}</p>
          <!-- Credenciais: faixa com três colunas separadas por filetes, ícone em anel, rótulo e valor -->
          <dl class="about__meta">
            <div><dt><LineIcon name="badge-check" class="about__meta-icon" />Inscrição</dt><dd>{site.oab}</dd></div>
            <div><dt><LineIcon name="scale" class="about__meta-icon" />Área</dt><dd>Direito do Trabalho</dd></div>
            <div><dt><LineIcon name="map-pin" class="about__meta-icon" />Atendimento</dt><dd>Online · todo o Brasil</dd></div>
          </dl>
          <div class="about__bio">
            <p>
              Sou advogada trabalhista, formada em Direito e pós-graduada em Direito e Processo do Trabalho. Desde o
              início da carreira, atuo no Direito do Trabalho.
            </p>
            <p>
              Já conduzi processos em todas as fases e instâncias, das audiências à sustentação oral nos tribunais,
              atuando para trabalhadores e para empresas. Essa experiência me ajuda a antecipar os argumentos da outra
              parte e a preparar cada caso com cuidado.
            </p>
            <p>
              No atendimento, priorizo a clareza: explico cada etapa em linguagem simples, para que você entenda o que
              está acontecendo e decida com segurança. E você fala diretamente comigo, do primeiro contato ao fim do
              processo.
            </p>
            <p>
              Também já dei aulas de Direito e Processo do Trabalho, experiência que reforçou meu cuidado em explicar
              cada tema com clareza.
            </p>
          </div>

          <!-- Formação: pequenos "diplomas" em grade, com ícone, nível e curso -->
          <h3 class="about-label"><span>Formação</span></h3>
          <ul class="edu">
            {education.map((e) => (
              <li class:list={['edu__item', { 'edu__item--main': e.main }]}>
                <span class="edu__mark" aria-hidden="true"><LineIcon name={e.icon} /></span>
                <LineIcon name={e.icon} class="edu__icon" />
                <div>
                  <p class="edu__level">{e.level}{e.main && <span class="edu__tag">Área de atuação</span>}</p>
                  <p class="edu__title">{e.title}</p>
                  {e.place && <p class="edu__place">{e.place}</p>}
                </div>
              </li>
            ))}
          </ul>

          <!-- Trajetória: linha do tempo vertical, com um ícone em anel em cada marco; o atual fica preenchido -->
          <h3 class="about-label"><span>Trajetória</span></h3>
          <ol class="tl">
            {timeline.map((t) => (
              <li class:list={['tl__item', { 'tl__item--now': t.current }]}>
                <LineIcon name={t.icon} class="tl__node" />
                <p class="tl__year">{t.year}</p>
                <p class="tl__text">{t.text}</p>
              </li>
            ))}
          </ol>

          <Button href={whatsappLink()} icon="whatsapp" local="sobre">Converse comigo pelo WhatsApp</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Faixa com o monograma ao fundo: de "Como funciona" até os diferenciais -->
  <div class="monogram-zone">
    <!-- Monograma da advogada como marca d'água: fica parado na tela enquanto as seções rolam -->
    <div class="monogram-bg" aria-hidden="true">
      <span class="brand__mark monogram-bg__mark"><span class="mono-g">G</span><span class="mono-c">C</span><span class="mono-g mono-g--over">G</span></span>
    </div>

  <!-- 5. Como funciona -->
  <section class="section" id="como-funciona">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Do primeiro contato <span class="soft">a cada etapa do processo.</span></h2>
      </div>
      <ol class="steps reveal">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">{pad(i + 1)}</span>
            <div class="step__card">
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Diferenciais -->
  <section class="section" aria-labelledby="diferenciais-titulo">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display" id="diferenciais-titulo">Técnica no processo, <span class="soft">clareza com você.</span></h2>
      </div>
      <!-- Vídeo decorativo, sem som, ao lado da lista: só ambientação, sem controles -->
      <div class="diffs-wrap">
        <div class="diffs-video" aria-hidden="true">
          <video muted loop playsinline preload="none" data-bg-video>
            <source data-src="/video/apresentacao.mp4" type="video/mp4" />
          </video>
        </div>
        <ul class="diffs reveal">
          {differentials.map((d) => (
            <li class="diff">
              <h3><LineIcon name={d.icon} class="diff__icon" />{d.title}</h3>
              <p>{d.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  </div>

  <!-- 6b. Artigos: painel suave com identidade de blog (selo, marca d'água de livro e cartões com foto desfocada) -->
  {latestPosts.length > 0 && (
    <div class="blog-panel-wrap">
      <section class="blog-panel" aria-labelledby="artigos-titulo">
        <span class="blog-panel__mark" aria-hidden="true"><Icon name="book" /></span>
        <div class="container">
          <div class="blog-panel__head reveal">
            <div>
              <p class="blog-panel__badge"><Icon name="book" /> Blog</p>
              <h2 class="display display--md" id="artigos-titulo">Artigos <span class="soft">recentes.</span></h2>
              <p class="blog-panel__intro">Textos curtos, em linguagem simples, sobre as dúvidas mais comuns do dia a dia do trabalho.</p>
            </div>
            <a class="blog-panel__all" href="/blog/"><span>Ver todos os artigos</span><Icon name="arrow" /></a>
          </div>
        </div>
        <!-- Trilho infinito: corre devagar, para com o mouse por cima e se arrasta. A lista vem três vezes
             (a do meio é a real; as cópias, escondidas de leitores de tela, só aparecem com o script ativo).
             Sem script ou com menos movimento, fica só a lista real em rolagem lateral comum. -->
        <div class="loop reveal" data-loop>
          <ul class="mini-posts loop__track" aria-label="Artigos recentes">
            {[0, 1, 2].map((copy) => latestPosts.map((post) => (
              <li {...(copy !== 1 ? { 'data-clone': '', 'aria-hidden': 'true' } : {})}>
                <a class="mini-post" href={postUrl(post)} draggable="false" {...(copy !== 1 ? { tabindex: '-1' } : {})}>
                  <span class="mini-post__media">
                    {post.data.cover && (
                      <Picture src={post.data.cover.src} alt="" widths={[320, 480]} sizes="340px" formats={['avif', 'webp']} draggable="false" />
                    )}
                    <span class="mini-post__cat">{post.data.category}</span>
                  </span>
                  <div class="mini-post__body">
                    <h3 class="mini-post__title">{post.data.title}</h3>
                    <span class="mini-post__meta">{readingTime(post)} <Icon name="arrow" /></span>
                  </div>
                </a>
              </li>
            )))}
          </ul>
        </div>
      </section>
    </div>
  )}

  <!-- 7. Perguntas frequentes: entram na faixa do monograma do fim padrão, logo acima do Instagram -->
  <section class="section" id="duvidas" slot="antes-do-fim">
    <div class="container faq">
      <div class="faq__aside reveal">
        <h2 class="display display--inline">Perguntas <span class="soft">frequentes.</span></h2>
      </div>
      <div class="faq__list reveal">
        {faq.map(({ q, a, link }) => (
          <details>
            <summary>{q}</summary>
            <p>{a}{link && <> <a href={link.href}>{link.label}</a>.</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Vídeo de fundo: só carrega e toca quando aparece na tela; pausa fora dela.
  // Quem prefere menos movimento vê apenas a imagem parada.
  const bgVideos = document.querySelectorAll<HTMLVideoElement>('[data-bg-video]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => {
        const video = target as HTMLVideoElement;
        if (isIntersecting) {
          const source = video.querySelector<HTMLSourceElement>('source[data-src]');
          if (source) { source.src = source.dataset.src!; source.removeAttribute('data-src'); video.load(); }
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    }, { rootMargin: '200px 0px' });
    bgVideos.forEach((v) => io.observe(v));
  }

  // Passos da seção do vídeo: fica ativo só o bloco mais próximo do centro da tela (os demais somem),
  // e apenas enquanto a seção está à vista.
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const stage = document.querySelector<HTMLElement>('.scrolly');
  if (steps.length && stage) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const mid = innerHeight / 2;
      const box = stage.getBoundingClientRect();
      // só começa quando o topo da seção já subiu bem (o vídeo aparece primeiro, o texto logo depois)
      const inView = box.top < innerHeight * 0.2 && box.bottom > mid;
      let best: HTMLElement | null = null;
      let bestDist = Infinity;
      if (inView) {
        steps.forEach((s) => {
          const r = s.getBoundingClientRect();
          const d = Math.abs(r.top + r.height / 2 - mid);
          if (d < bestDist) { bestDist = d; best = s; }
        });
      }
      steps.forEach((s) => s.classList.toggle('is-active', s === best));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }

  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Faixa de empresas: a cortina azul corre da direita enquanto a faixa sobe do pé da tela até 35% dela.
  const curtain = document.querySelector<HTMLElement>('[data-curtain]');
  if (curtain && !calm) {
    curtain.classList.add('is-curtain');
    let ticking = false;
    const draw = () => {
      ticking = false;
      const p = Math.min(1, Math.max(0, (innerHeight - curtain.getBoundingClientRect().top) / (innerHeight * 0.65)));
      curtain.style.setProperty('--c', (1 - p) ** 3 + ''); // 1 → 0, desacelerando no fim
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(draw); } }, { passive: true });
    addEventListener('resize', draw);
    draw();
  }

  // Artigos em trilho infinito: corre devagar, para com o mouse ou o foco, e se arrasta com mouse ou dedo.
  // A posição fica sempre na cópia do meio; ao passar de meia cópia para um lado, volta um ciclo inteiro
  // (as cópias são idênticas, então não há salto visível).
  const loop = document.querySelector<HTMLElement>('[data-loop]');
  const loopTrack = loop?.querySelector<HTMLElement>('.loop__track');
  if (loop && loopTrack && !calm) {
    loop.classList.add('is-looping');
    let x = 0, cycle = 0, hover = false, focused = false, visible = false, vel = 0, moved = false, frame = 0;
    let drag: { x: number; y: number; start: number; id: number; axis: '' | 'x' | 'y' } | null = null;
    const measure = () => {
      const first = loopTrack.children[0] as HTMLElement;
      const middle = loopTrack.children[loopTrack.children.length / 3] as HTMLElement;
      const next = cycle ? x / cycle : -1;
      cycle = middle.offsetLeft - first.offsetLeft;
      x = next * cycle;
    };
    const wrap = (dx: number) => { x += dx; if (drag) drag.start += dx; };
    const tick = () => {
      frame = 0;
      if (!drag) { vel *= 0.94; x += vel + (hover || focused || Math.abs(vel) > 0.2 ? 0 : -0.35); }
      if (x > -cycle * 0.5) wrap(-cycle);
      if (x < -cycle * 1.5) wrap(cycle);
      loopTrack.style.transform = `translate3d(${x}px, 0, 0)`;
      if (visible) frame = requestAnimationFrame(tick);
    };
    // só anima com o trilho na tela
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !frame) frame = requestAnimationFrame(tick);
    }).observe(loop);

    loop.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    loop.addEventListener('pointerleave', () => { hover = false; });
    // Com o teclado, o cartão em foco é trazido para a vista (o navegador rolaria o trilho por conta própria)
    loop.addEventListener('focusin', (e) => {
      focused = true;
      loop.scrollLeft = 0;
      const card = (e.target as HTMLElement).closest('li');
      if (card) x = -(card.offsetLeft - parseFloat(getComputedStyle(loopTrack).paddingLeft));
    });
    loop.addEventListener('focusout', () => { focused = false; });
    loop.addEventListener('pointerdown', (e) => {
      drag = { x: e.clientX, y: e.clientY, start: x, id: e.pointerId, axis: '' }; moved = false; vel = 0;
    });
    addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      // no toque, decide pelo primeiro movimento: de lado arrasta o trilho, para baixo rola a página
      if (!drag.axis && Math.hypot(dx, dy) > 6) {
        drag.axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        if (drag.axis === 'x') { loop.classList.add('is-dragging'); loop.setPointerCapture(drag.id); }
      }
      if (drag.axis !== 'x') return;
      moved = true;
      const nx = drag.start + dx; vel = nx - x; x = nx;
    });
    const stop = () => { if (drag) { drag = null; loop.classList.remove('is-dragging'); } };
    addEventListener('pointerup', stop);
    addEventListener('pointercancel', stop);
    // Se arrastou, não abre o artigo ao soltar
    loop.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
    loop.addEventListener('dragstart', (e) => e.preventDefault());

    measure();
    addEventListener('resize', measure);
    addEventListener('load', measure);
  }
</script>
