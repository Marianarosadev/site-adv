---
import { Picture, getImage } from 'astro:assets';
import sharp from 'sharp';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import AreaIcon from '../components/AreaIcon.astro';
import fotoEscritorio from '../assets/giovanna-escritorio.jpg';
import fotoPerfil from '../assets/giovanna-perfil.jpg';
import {
  site, whatsappLink, areas, stats, timeline, education, steps, differentials, faq,
} from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');

// Foto do topo: mesmas opções no <Picture> e no preload, para o navegador baixar o arquivo certo o quanto antes.
const heroWidths = [640, 1000, 1086];
const heroSizes = '(min-width: 900px) 64vw, 100vw';
const heroPreload = await getImage({ src: fotoEscritorio, widths: heroWidths, sizes: heroSizes, format: 'avif' });
// Prévia minúscula (~1 KB) embutida no HTML: aparece desfocada na hora, enquanto a foto real carrega.
const heroPlaceholder = `data:image/webp;base64,${(
  await sharp('src/assets/giovanna-escritorio.jpg').resize(32).webp({ quality: 50 }).toBuffer()
).toString('base64')}`;
const shortcuts = [
  { label: 'Rescisão', hint: 'Recebi tudo?', id: 'area-01', icon: 'receipt-text' },
  { label: 'Horas extras', hint: 'Jornada sem pagamento', id: 'area-02', icon: 'clock' },
  { label: 'Justa causa', hint: 'Posso contestar?', id: 'area-04', icon: 'gavel' },
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': ['LegalService', 'Attorney'],
    name: `${site.fullName}, Advogada Trabalhista`,
    description: 'Advogada trabalhista em Goiânia, com atendimento online para trabalhadores em todo o Brasil.',
    url: Astro.site?.href,
    telephone: site.phoneE164,
    email: site.email,
    image: new URL('/og-image.jpg', Astro.site).href,
    identifier: site.oab,
    knowsAbout: ['Direito do Trabalho', 'Processo do Trabalho', ...areas.map((a) => a.title)],
    areaServed: [
      { '@type': 'City', name: 'Goiânia' },
      { '@type': 'State', name: 'Goiás' },
      { '@type': 'Country', name: 'Brasil' },
    ],
    availableLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Layout
  title="Advogada Trabalhista em Goiânia | Dra. Giovanna Cabral, OAB/GO 66.313"
  description="Advogada trabalhista em Goiânia, com atendimento online. Orientação sobre rescisão, horas extras, justa causa, carteira não assinada e outros direitos do trabalhador. Fale pelo WhatsApp."
  schema={schema}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes={heroSizes}
    fetchpriority="high"
  />

  <!-- 1. Topo -->
  <section class="hero" id="topo" data-hero>
    <div class="hero__bg">
      <div class="hero__placeholder" style={`background-image: url(${heroPlaceholder})`} aria-hidden="true"></div>
      <Picture
        src={fotoEscritorio}
        alt="Dra. Giovanna Cabral, advogada trabalhista, analisando um processo em seu escritório"
        widths={heroWidths}
        sizes={heroSizes}
        onload="this.classList.add('is-loaded')"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__watermark" aria-hidden="true">DIREITOS</div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow eyebrow--pill">Goiânia · Atendimento online para todo o Brasil</p>
        <h1 class="display display--hero">
          Advogada trabalhista <span class="soft">ao lado de quem trabalha.</span>
        </h1>
        <p class="hero__intro">
          Sou a <strong>Dra. Giovanna Cabral, {site.oab}</strong>. Oriento e represento trabalhadores em questões como
          rescisão, horas extras, justa causa e carteira não assinada, com linguagem clara e atendimento 100% online.
        </p>
        <div class="hero__actions">
          <Button href={whatsappLink()} icon="whatsapp">Falar no WhatsApp</Button>
          <a class="btn btn--ghost" href="#como-posso-ajudar">Ver como posso ajudar</a>
        </div>
        <div class="cred">
          <Picture src={fotoPerfil} alt="" widths={[88]} sizes="44px" formats={['avif', 'webp']} />
          <span>Pós-graduada em Direito e Processo do Trabalho · Na advocacia trabalhista desde 2020</span>
        </div>
      </div>

      <nav class="chips" aria-label="Temas mais procurados">
        <span class="chips__label" aria-hidden="true">Mais procurados</span>
        {shortcuts.map((s) => (
          <a class="chip" href={`#${s.id}`}>
            <AreaIcon name={s.icon} class="chip__icon" />
            <span class="chip__text">
              <strong>{s.label}</strong>
              <small>{s.hint}</small>
            </span>
            <Icon name="arrow" />
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- 2. Apresentação e números -->
  <section class="section section--intro" aria-label="Apresentação">
    <div class="container">
      <div class="statement reveal">
        <div class="statement__label">
          <Picture src={fotoPerfil} alt="" widths={[80]} sizes="40px" formats={['avif', 'webp']} />
          Sobre o atendimento
        </div>
        <p class="statement__text">
          Já atuei dos dois lados do processo trabalhista.{' '}
          <span class="soft">Por isso conheço os argumentos das empresas e preparo cada caso do trabalhador com atenção a cada detalhe.</span>
        </p>
      </div>
      <dl class="stats reveal">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat__label">{s.label}</dt>
            <dd class="stat__value">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 3. Como posso ajudar -->
  <section class="section" id="como-posso-ajudar">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Como posso ajudar <span class="soft">no seu caso.</span></h2>
        <p>Direito do Trabalho em Goiânia e online. Encontre a situação mais parecida com a sua e fale comigo.</p>
      </div>
      <ul class="areas">
        {areas.map((area, i) => (
          <li class="area reveal" id={`area-${pad(i + 1)}`}>
            <div class="area__head">
              <AreaIcon name={area.icon} />
              <h3 class="area__title">{area.title}</h3>
            </div>
            <p class="area__situation">“{area.situation}”</p>
            <p class="area__text">{area.text}</p>
            <a class="link-arrow link-arrow--whatsapp" href={whatsappLink(area.message)} target="_blank" rel="noopener">
              <Icon name="whatsapp" /> Conversar sobre isso
            </a>
          </li>
        ))}
        <li class="area area--cta reveal">
          <div>
            <h3 class="area__title">Não encontrou a sua situação?</h3>
            <p class="area__text">Me conte o que aconteceu. Eu explico se e como o seu caso pode ser analisado.</p>
          </div>
          <Button href={whatsappLink()} icon="whatsapp">Tire sua dúvida pelo WhatsApp</Button>
        </li>
      </ul>
      <p class="areas-foot small reveal">
        <span><strong>Também atendo empresas:</strong> defesa em reclamações trabalhistas, audiências, acordos e pareceres.</span>
      </p>
    </div>
  </section>

  <!-- 4. Sobre -->
  <section class="section" id="sobre">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Prazer, <span class="soft">Giovanna Cabral.</span></h2>
      </div>
      <div class="about">
        <div class="about__photo reveal">
          <Picture
            src={fotoPerfil}
            alt="Retrato de perfil da advogada trabalhista Giovanna Cabral"
            widths={[480, 720, 1000]}
            sizes="(min-width: 900px) 460px, 100vw"
            formats={['avif', 'webp']}
          />
        </div>
        <div class="reveal">
          <p class="about__role">{site.fullName} · Advogada trabalhista · {site.oab}</p>
          <dl class="about__meta">
            <div><dt>Atuação</dt><dd>Desde 2020</dd></div>
            <div><dt>Inscrição</dt><dd>{site.oab}</dd></div>
            <div><dt>Atendimento</dt><dd>Online</dd></div>
          </dl>
          <div class="about__bio">
            <p>
              Comecei na advocacia trabalhista em 2020, ainda como estagiária, e desde 2022 atuo como advogada. Me formei
              em Direito pela PUC Goiás no tempo regular e fiz pós-graduação em Direito do Trabalho e Processo do Trabalho.
            </p>
            <p>
              Como advogada plena, conduzi processos trabalhistas em todas as fases e instâncias, das audiências à
              sustentação oral nos tribunais. Atuei tanto para trabalhadores quanto para empresas. Essa vivência me ensinou
              a antecipar os argumentos do outro lado e a explicar cada etapa de forma simples para quem está vivendo o problema.
            </p>
            <p>
              Também dou aulas e preparo candidatos para o Exame da OAB, porque gosto de ensinar e de manter o
              conhecimento técnico sempre em dia.
            </p>
          </div>

          <h3 class="subhead">Formação</h3>
          <ul class="rows rows--plain">
            {education.map((item) => <li>{item}</li>)}
          </ul>

          <h3 class="subhead">Trajetória</h3>
          <ul class="rows">
            {timeline.map((t) => (
              <li><span class="row__key">{t.year}</span><span>{t.text}</span></li>
            ))}
          </ul>

          <Button href={whatsappLink()} icon="whatsapp">Converse comigo pelo WhatsApp</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Como funciona -->
  <section class="section" id="como-funciona">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Do primeiro contato <span class="soft">a cada etapa do processo.</span></h2>
        <p>Tudo online: você não precisa sair de casa nem do trabalho.</p>
      </div>
      <ol class="steps reveal">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="steps-cta reveal">
        <Button href={whatsappLink()} icon="whatsapp">Começar pelo WhatsApp</Button>
      </div>
    </div>
  </section>

  <!-- 6. Diferenciais -->
  <section class="section" aria-labelledby="diferenciais-titulo">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display" id="diferenciais-titulo">Técnica no processo, <span class="soft">clareza com você.</span></h2>
      </div>
      <ul class="diffs reveal">
        {differentials.map((d) => (
          <li class="diff"><h3>{d.title}</h3><p>{d.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. Perguntas frequentes -->
  <section class="section" id="duvidas">
    <div class="container faq">
      <div class="faq__aside reveal">
        <h2 class="display">Dúvidas <span class="soft">respondidas.</span></h2>
        <p>Ainda com dúvida? Fale comigo pelo <a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a>.</p>
      </div>
      <div class="faq__list reveal">
        {faq.map(({ q, a }) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Contato -->
  <div class="contact-wrap" id="contato">
    <section class="contact" aria-labelledby="contato-titulo">
      <div class="container contact__grid">
        <div class="reveal">
          <h2 class="display" id="contato-titulo">Vamos conversar <span class="soft">sobre o seu caso.</span></h2>
          <p class="contact__intro">
            Me conte o que aconteceu pelo WhatsApp. O primeiro passo é entender a sua situação, e para isso você não
            precisa ter todos os documentos em mãos.
          </p>
          <ul class="next">
            <li><b>Ao enviar a mensagem</b><span>Eu leio e respondo pessoalmente</span></li>
            <li><b>Na conversa</b><span>Entendo o caso e indico os documentos</span></li>
            <li><b>Antes de qualquer trabalho</b><span>Contrato por escrito, assinado digitalmente</span></li>
            <li><b>Durante o processo</b><span>Você é informado de cada etapa importante</span></li>
          </ul>
          <dl class="contact__info">
            <div><dt>WhatsApp</dt><dd><a href={whatsappLink()} target="_blank" rel="noopener">{site.phoneDisplay}</a></dd></div>
            <div><dt>Telefone</dt><dd><a href={`tel:${site.phoneE164}`}>Ligar agora</a></dd></div>
            <div><dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
            <div><dt>Horário</dt><dd>{site.hours}</dd></div>
            <div><dt>Atendimento</dt><dd>Online · {site.city} e todo o Brasil</dd></div>
          </dl>
        </div>

        <form class="form-card reveal" data-wa-form novalidate>
          <h3>Envie sua mensagem</h3>
          <p>O formulário monta a mensagem e abre o WhatsApp para você enviar.</p>
          <div class="field-row">
            <div class="field">
              <label for="f-nome">Nome</label>
              <input id="f-nome" name="nome" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="f-tel">WhatsApp</label>
              <input id="f-tel" name="telefone" type="tel" autocomplete="tel" inputmode="tel" required />
            </div>
          </div>
          <div class="field">
            <label for="f-assunto">Assunto</label>
            <select id="f-assunto" name="assunto" required>
              <option value="">Escolha o mais próximo</option>
              {areas.map((a) => <option>{a.title}</option>)}
              <option>Outro</option>
            </select>
          </div>
          <div class="field">
            <label for="f-msg">Conte brevemente o que aconteceu <span>(opcional)</span></label>
            <textarea id="f-msg" name="mensagem" rows="3"></textarea>
          </div>
          <label class="consent">
            <input type="checkbox" name="consentimento" required />
            <span>
              Entendo que este contato não cria vínculo de contratação e concordo com o uso dos meus dados para retorno,
              conforme a <a href="/politica-de-privacidade/">Política de Privacidade</a>.
            </span>
          </label>
          <button class="btn btn--whatsapp btn--block" type="submit">
            <Icon name="whatsapp" />
            <span>Enviar pelo WhatsApp</span>
          </button>
          <p class="form-note" data-form-error role="alert" hidden>Preencha nome, WhatsApp, assunto e marque a caixa de concordância.</p>
          <p class="form-note">Não envie documentos ou informações sigilosas antes do primeiro retorno.</p>
        </form>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { site } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-wa-form]');
  const error = document.querySelector<HTMLElement>('[data-form-error]');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      if (error) error.hidden = false;
      form.querySelector<HTMLElement>(':invalid')?.focus();
      return;
    }
    if (error) error.hidden = true;

    const data = new FormData(form);
    const lines = [
      `Olá, Dra. Giovanna! Vim pelo site.`,
      `Nome: ${data.get('nome')}`,
      `WhatsApp: ${data.get('telefone')}`,
      `Assunto: ${data.get('assunto')}`,
    ];
    const message = String(data.get('mensagem') ?? '').trim();
    if (message) lines.push(`Mensagem: ${message}`);

    const url = `https://wa.me/${site.phoneE164.replace('+', '')}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
  });
</script>
