---
import { Picture, getImage } from 'astro:assets';
import sharp from 'sharp';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import AreaIcon from '../components/AreaIcon.astro';
import ContactCard from '../components/ContactCard.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../data/blog';
import fotoEscritorio from '../assets/giovanna-escritorio.jpg';
import fotoPerfil from '../assets/giovanna-perfil.jpg';
import {
  site, whatsappLink, whatsappEmpresa, firstMessage, areas, stats, timeline, education, steps, differentials, faq,
  servicesEmpresa,
} from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
const latestPosts = (await getPosts()).slice(0, 3);

// Foto do topo: mesmas opções no <Picture> e no preload, para o navegador baixar o arquivo certo o quanto antes.
const heroWidths = [640, 1000, 1086];
const heroSizes = '(min-width: 900px) 64vw, 100vw';
const heroPreload = await getImage({ src: fotoEscritorio, widths: heroWidths, sizes: heroSizes, format: 'avif' });
// Prévia minúscula (~1 KB) embutida no HTML: aparece desfocada na hora, enquanto a foto real carrega.
const heroPlaceholder = `data:image/webp;base64,${(
  await sharp('src/assets/giovanna-escritorio.jpg').resize(32).webp({ quality: 50 }).toBuffer()
).toString('base64')}`;
const shortcuts = [
  { label: 'Rescisão', hint: 'Recebi tudo?', id: 'area-rescisao', icon: 'receipt-text' },
  { label: 'Horas extras', hint: 'Jornada sem pagamento', id: 'area-horas-extras', icon: 'clock' },
  { label: 'Carteira não assinada', hint: 'Sem registro ou PJ', id: 'area-carteira-nao-assinada', icon: 'id-card' },
] as const;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': ['LegalService', 'Attorney'],
    name: `${site.fullName}, Advogada Trabalhista`,
    description: 'Advogada trabalhista em Goiânia, com atendimento online para trabalhadores e empresas em todo o Brasil.',
    url: Astro.site?.href,
    telephone: site.phoneE164,
    email: site.email,
    image: new URL('/og-image.jpg', Astro.site).href,
    identifier: site.oab,
    knowsAbout: ['Direito do Trabalho', 'Processo do Trabalho', ...areas.map((a) => a.title)],
    areaServed: [
      { '@type': 'City', name: 'Goiânia' },
      { '@type': 'State', name: 'Goiás' },
      { '@type': 'Country', name: 'Brasil' },
    ],
    availableLanguage: 'pt-BR',
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Layout
  title="Advogada Trabalhista em Goiânia e Online | Dra. Giovanna Cabral, OAB/GO 66.313"
  description="Advogada trabalhista em Goiânia, com atendimento online em todo o Brasil. Orientação sobre rescisão, horas extras, rescisão indireta e carteira não assinada. Também atendo empresas."
  schema={schema}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes={heroSizes}
    fetchpriority="high"
  />

  <!-- 1. Topo -->
  <section class="hero" id="topo" data-hero>
    <div class="hero__bg">
      <div class="hero__placeholder" style={`background-image: url(${heroPlaceholder})`} aria-hidden="true"></div>
      <Picture
        src={fotoEscritorio}
        alt="Dra. Giovanna Cabral, advogada trabalhista, analisando um processo em seu escritório"
        widths={heroWidths}
        sizes={heroSizes}
        onload="this.classList.add('is-loaded')"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__watermark" aria-hidden="true">DIREITOS</div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow eyebrow--pill">Goiânia · Atendimento online para todo o Brasil</p>
        <h1 class="display display--hero">
          Advogada trabalhista <span class="soft">ao lado de quem trabalha.</span>
        </h1>
        <p class="hero__intro">
          Sou a <strong>Dra. Giovanna Cabral, {site.oab}</strong>. Oriento e represento trabalhadores em questões como
          rescisão, horas extras, rescisão indireta e carteira não assinada, com linguagem clara e atendimento 100%
          online. Também atendo empresas.
        </p>
        <div class="hero__actions">
          <Button href={whatsappLink()} icon="whatsapp" local="topo" publico="geral">Falar no WhatsApp</Button>
          <a class="btn btn--ghost" href="/empresas/">Atendimento para empresas</a>
        </div>
        <div class="cred">
          <Picture src={fotoPerfil} alt="" widths={[88]} sizes="44px" formats={['avif', 'webp']} />
          <span>{site.title} · {site.oab}</span>
        </div>
      </div>

      <nav class="chips" aria-label="Temas mais procurados">
        <span class="chips__label" aria-hidden="true">Mais procurados</span>
        {shortcuts.map((s) => (
          <a class="chip" href={`#${s.id}`}>
            <AreaIcon name={s.icon} class="chip__icon" />
            <span class="chip__text">
              <strong>{s.label}</strong>
              <small>{s.hint}</small>
            </span>
            <Icon name="arrow" />
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- 2. Apresentação e números -->
  <section class="section section--intro" aria-label="Apresentação">
    <div class="container">
      <div class="statement reveal">
        <div class="statement__label">
          <Picture src={fotoPerfil} alt="" widths={[80]} sizes="40px" formats={['avif', 'webp']} />
          Sobre o atendimento
        </div>
        <p class="statement__text">
          Cada caso é analisado com atenção aos detalhes.{' '}
          <span class="soft">E cada etapa é explicada de forma simples, para você decidir com segurança.</span>
        </p>
      </div>
      <dl class="stats reveal">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat__label">{s.label}</dt>
            <dd class="stat__value">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 3. Como posso ajudar -->
  <section class="section" id="como-posso-ajudar">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Como posso ajudar <span class="soft">no seu caso.</span></h2>
        <p>Direito do Trabalho em Goiânia e online. Encontre a situação mais parecida com a sua e fale comigo.</p>
      </div>
      <ul class="areas">
        {areas.map((area) => (
          <li class="area reveal" id={`area-${area.slug}`}>
            <div class="area__head">
              <AreaIcon name={area.icon} />
              <h3 class="area__title">{area.href ? <a href={area.href}>{area.title}</a> : area.title}</h3>
            </div>
            <p class="area__situation">“{area.situation}”</p>
            <p class="area__text">{area.text}</p>
            <div class="area__links">
              <a
                class="link-arrow link-arrow--whatsapp"
                href={whatsappLink(area.message)}
                target="_blank"
                rel="noopener"
                data-local={`card-${area.slug}`}
                data-tema={area.slug}
                data-publico="trabalhador"
              >
                <Icon name="whatsapp" /> Conversar sobre isso
              </a>
              {area.href && <a class="link-arrow" href={area.href}>Entenda</a>}
            </div>
          </li>
        ))}
        <li class="area area--cta reveal">
          <div>
            <h3 class="area__title">Não encontrou a sua situação?</h3>
            <p class="area__text">Me conte o que aconteceu. Eu explico se e como o seu caso pode ser analisado.</p>
          </div>
          <Button href={whatsappLink()} icon="whatsapp" local="card-outro" publico="trabalhador">Tire sua dúvida pelo WhatsApp</Button>
        </li>
      </ul>
    </div>
  </section>

  <!-- 3b. Para empresas -->
  <section class="section section--tight" id="para-empresas" aria-labelledby="empresas-titulo">
    <div class="container">
      <div class="band-empresas reveal">
        <div class="band-empresas__head">
          <p class="eyebrow">Para empresas</p>
          <h2 class="band-empresas__title" id="empresas-titulo">Atendimento para empresas</h2>
          <p>Defesa da empresa na Justiça do Trabalho, do recebimento da notificação até o fim do processo.</p>
        </div>
        <ul class="band-empresas__list">
          {servicesEmpresa.map((s) => <li>{s.title}</li>)}
        </ul>
        <div class="band-empresas__actions">
          <a class="btn btn--azul" href="/empresas/">Ver atendimento para empresas</a>
          <a class="link-arrow link-arrow--whatsapp" href={whatsappEmpresa()} target="_blank" rel="noopener" data-local="faixa-empresas" data-publico="empresa">
            <Icon name="whatsapp" /> WhatsApp para empresas
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Sobre -->
  <section class="section" id="sobre">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Prazer, <span class="soft">Giovanna Cabral.</span></h2>
      </div>
      <div class="about">
        <div class="about__photo reveal">
          <Picture
            src={fotoPerfil}
            alt="Retrato de perfil da advogada trabalhista Giovanna Cabral"
            widths={[480, 720, 1000]}
            sizes="(min-width: 900px) 460px, 100vw"
            formats={['avif', 'webp']}
          />
        </div>
        <div class="reveal">
          <p class="about__role">{site.fullName} · Advogada trabalhista · {site.oab}</p>
          <dl class="about__meta">
            <div><dt>Inscrição</dt><dd>{site.oab}</dd></div>
            <div><dt>Área</dt><dd>Direito do Trabalho</dd></div>
            <div><dt>Atendimento</dt><dd>Online · todo o Brasil</dd></div>
          </dl>
          <div class="about__bio">
            <p>
              Comecei na advocacia trabalhista em 2020, ainda como estagiária, e desde 2022 atuo como advogada. Me formei
              em Direito pela PUC Goiás no tempo regular e fiz pós-graduação em Direito do Trabalho e Processo do Trabalho.
            </p>
            <p>
              Como advogada plena, conduzi processos trabalhistas em todas as fases e instâncias, das audiências à
              sustentação oral nos tribunais. Atuei tanto para trabalhadores quanto para empresas. Essa vivência me ensinou
              a antecipar os argumentos do outro lado e a explicar cada etapa de forma simples para quem está vivendo o problema.
            </p>
            <p>
              Também dou aulas de Direito e Processo do Trabalho, porque gosto de ensinar e de manter o conhecimento
              técnico sempre em dia.
            </p>
            <p>
              <a class="link-arrow link-arrow--wrap" href={site.cna} target="_blank" rel="noopener">Confira minha inscrição no Cadastro Nacional dos Advogados</a>
            </p>
          </div>

          <h3 class="subhead">Formação</h3>
          <ul class="rows rows--plain">
            {education.map((item) => <li>{item}</li>)}
          </ul>

          <h3 class="subhead">Trajetória</h3>
          <ul class="rows">
            {timeline.map((t) => (
              <li><span class="row__key">{t.year}</span><span>{t.text}</span></li>
            ))}
          </ul>

          <Button href={whatsappLink()} icon="whatsapp" local="sobre">Converse comigo pelo WhatsApp</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Como funciona -->
  <section class="section" id="como-funciona">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display">Do primeiro contato <span class="soft">a cada etapa do processo.</span></h2>
        <p>Tudo online: você não precisa sair de casa nem do trabalho.</p>
      </div>
      <ol class="steps reveal">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">{pad(i + 1)}</span>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="steps-cta reveal">
        <Button href={whatsappLink()} icon="whatsapp" local="como-funciona">Começar pelo WhatsApp</Button>
      </div>
    </div>
  </section>

  <!-- 6. Diferenciais -->
  <section class="section" aria-labelledby="diferenciais-titulo">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display" id="diferenciais-titulo">Técnica no processo, <span class="soft">clareza com você.</span></h2>
      </div>
      <ul class="diffs reveal">
        {differentials.map((d) => (
          <li class="diff"><h3>{d.title}</h3><p>{d.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6b. Artigos recentes -->
  {latestPosts.length > 0 && (
    <section class="section" aria-labelledby="artigos-titulo">
      <div class="container">
        <div class="section-head reveal">
          <h2 class="display" id="artigos-titulo">Artigos <span class="soft">recentes.</span></h2>
          <a class="link-arrow" href="/blog/">Ver todos os artigos</a>
        </div>
        <ul class="posts posts--filtered reveal">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </ul>
      </div>
    </section>
  )}

  <!-- 7. Perguntas frequentes -->
  <section class="section" id="duvidas">
    <div class="container faq">
      <div class="faq__aside reveal">
        <h2 class="display">Dúvidas <span class="soft">respondidas.</span></h2>
        <p>Ainda com dúvida? Fale comigo pelo <a href={whatsappLink()} target="_blank" rel="noopener" data-local="duvidas">WhatsApp</a>.</p>
      </div>
      <div class="faq__list reveal">
        {faq.map(({ q, a, link }) => (
          <details>
            <summary>{q}</summary>
            <p>{a}{link && <> <a href={link.href}>{link.label}</a>.</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. Contato -->
  <div class="contact-wrap" id="contato">
    <section class="contact" aria-labelledby="contato-titulo">
      <div class="container contact__grid">
        <div class="reveal">
          <h2 class="display" id="contato-titulo">Vamos conversar <span class="soft">sobre o seu caso.</span></h2>
          <p class="contact__intro">
            Me conte o que aconteceu pelo WhatsApp. O primeiro passo é entender a sua situação, e para isso você não
            precisa ter todos os documentos em mãos.
          </p>
          <ul class="next">
            <li><b>Ao enviar a mensagem</b><span>Eu leio e respondo pessoalmente</span></li>
            <li><b>Na conversa</b><span>Entendo o caso e indico os documentos</span></li>
            <li><b>Antes de qualquer trabalho</b><span>Contrato por escrito, assinado digitalmente</span></li>
            <li><b>Durante o processo</b><span>Você é informado de cada etapa importante</span></li>
          </ul>
        </div>

        <ContactCard whatsapp={whatsappLink()} checklist={firstMessage} publico="geral" />
      </div>
    </section>
  </div>
</Layout>
