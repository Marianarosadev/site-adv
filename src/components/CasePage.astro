---
// Página completa de um tema de /trabalhista/ (os nove casos e a página de rescisão dos anúncios), no mesmo
// padrão da home e de /empresas/: topo com a foto do tema ao fundo, índice da página, seções com mecânicas
// diferentes entre si e o fim padrão do site. Cada página só monta o conteúdo e repassa as opções do Layout.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ComponentProps } from 'astro/types';
import Layout from '../layouts/Layout.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import AreaIcon from './AreaIcon.astro';
import RelatedPosts from './RelatedPosts.astro';
import fotoPerfil from '../assets/giovanna-perfil.jpg';
import { site, telLink, steps, areas, areaUrl } from '../data/site';
import type { Post } from '../data/blog';

type Title = [string, string];

interface Props {
  layout: Omit<ComponentProps<typeof Layout>, 'leitura'>;
  slug: string;
  crumbs?: { label: string; href?: string }[];
  h1: Title;
  quote: string;
  intro: string;
  photo: { src: ImageMetadata; alt: string; credit: string };
  // Prefixo do data-local dos botões (medição): 'caso' nas páginas de tema, 'lp' na página dos anúncios.
  local: string;
  cta: string;
  what?: string[];
  when: { title: Title; items: string[]; note: string };
  rights: { title: Title; intro: string; items: { title: string; text: string }[] };
  proof: { title: Title; items: string[] };
  deadlines: { title: Title; items: { value: string; text: string }[] };
  faq: { q: string; a: string }[];
  related: Post[];
  topic: string;
  // Outros temas no fim (fica de fora na página dos anúncios, para não tirar o foco).
  others?: boolean;
}

const {
  layout, slug, crumbs, h1, quote, intro, photo, local, cta, what, when, rights, proof, deadlines, faq, related, topic,
  others = true,
} = Astro.props;
const wa = layout.whatsapp;
const pad = (n: number) => String(n).padStart(2, '0');
const area = areas.find((a) => a.slug === slug);
const otherAreas = others ? areas.filter((a) => a.slug !== slug) : [];
// Etapas do atendimento: o rótulo de cada fase fica acima do título, como na linha do tempo de /empresas/.
const phases = ['Primeiro contato', 'Análise', 'Orientação', 'Acompanhamento'];
// "10 dias" → o número conta até 10 quando aparece; o resto do texto fica parado.
const splitValue = (v: string) => v.match(/^(\D*)(\d+)(.*)$/);

// Índice da página: só as seções que existem nela.
const chapters = [
  what && { id: 'entenda', label: 'Entenda' },
  { id: 'quando', label: when.title.join(' ').replace(/[.?]$/, '') },
  { id: 'direitos', label: 'Direitos' },
  { id: 'provas', label: 'Provas' },
  { id: 'prazos', label: 'Prazos' },
  { id: 'como-funciona', label: 'Como funciona' },
  { id: 'duvidas', label: 'Dúvidas' },
].filter(Boolean) as { id: string; label: string }[];
---
<Layout {...layout} leitura>
  <!-- 1. Topo: a foto do tema ocupa o fundo, sob um véu vinho que escurece do lado do texto. A foto entra
       devagar (leve recuo da escala) e sobe mais devagar que a página. -->
  <section class="case-top" data-case-top>
    <div class="case-top__bg" aria-hidden="true">
      <Picture
        src={photo.src}
        alt=""
        widths={[640, 1000, 1600]}
        sizes="100vw"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container case-top__inner">
      {crumbs && (
        <nav class="case-top__crumbs" aria-label="Você está em">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span aria-hidden="true">/</span>}
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )}
      <p class="case-top__kicker">
        {area && <AreaIcon name={area.icon} />}
        Direito do Trabalho · atendimento online
      </p>
      <h1 class="case-top__title">{h1[0]} <em>{h1[1]}</em></h1>
      <p class="case-top__quote">“{quote}”</p>
      <p class="case-top__intro">{intro}</p>
      <div class="case-top__actions">
        <Button href={wa!} icon="whatsapp" local={`${local}-topo`} tema={slug} publico="trabalhador">{cta}</Button>
        <Button href={telLink} icon="phone" class="case-top__call" local={`${local}-topo`} tema={slug} publico="trabalhador">Ligar</Button>
      </div>
      <div class="case-top__foot">
        <p class="case-top__cred">
          <Picture src={fotoPerfil} alt="" widths={[88]} sizes="44px" formats={['avif', 'webp']} loading="eager" />
          <span><strong>{site.fullName}</strong> · {site.oab}<br />{site.title}</span>
        </p>
        <p class="case-top__credit">Imagem ilustrativa · Foto: {photo.credit} / Unsplash</p>
      </div>
    </div>
  </section>

  <!-- Índice da página: atalhos numerados para cada seção (desliza para o lado no celular) -->
  <nav class="case-index" aria-label="Nesta página">
    <div class="container case-index__inner">
      <span class="case-index__label">Nesta página</span>
      <ol>
        {chapters.map((c, i) => <li><a href={`#${c.id}`}><span>{pad(i + 1)}</span>{c.label}</a></li>)}
      </ol>
    </div>
  </nav>

  <!-- 2. Entenda: título fixo à esquerda; o primeiro parágrafo em destaque, como a abertura de uma matéria -->
  {what && (
    <section class="section section--tight" id="entenda" data-secao="Entenda o seu direito" aria-labelledby="entenda-titulo">
      <div class="container case-read">
        <h2 class="display display--md case-read__title reveal" id="entenda-titulo">Entenda <span class="soft">o seu direito.</span></h2>
        <div class="case-read__text reveal">
          {what.map((p, i) => <p class:list={{ 'case-read__lead': i === 0 }}>{p}</p>)}
        </div>
      </div>
    </section>
  )}

  <!-- 3. Quando: as situações na voz de quem procura, cada uma com um tique que se desenha ao aparecer -->
  <section class="section section--tight" id="quando" data-secao={when.title.join(' ')} aria-labelledby="quando-titulo">
    <div class="container">
      <h2 class="display display--md display--inline case-head reveal" id="quando-titulo">{when.title[0]} <span class="soft">{when.title[1]}</span></h2>
      <ul class="case-when">
        {when.items.map((s, i) => (
          <li class="reveal" style={`--i: ${i % 2}`}>
            <svg class="case-when__tick" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" /><path d="m7.5 12.5 3 3 6-7" /></svg>
            <span>{s}</span>
          </li>
        ))}
      </ul>
      <div class="case-when__note reveal">
        <p>{when.note}</p>
        <a href={wa} target="_blank" rel="noopener" data-local={`${local}-quando`} data-tema={slug} data-publico="trabalhador">Conversar sobre o meu caso <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 4. Direitos: grade de filetes, sem caixas; cada item numerado, com o filete de cima acendendo no hover -->
  <section class="section section--tight" id="direitos" data-secao="Direitos" aria-labelledby="direitos-titulo">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="display display--md" id="direitos-titulo">{rights.title[0]} <span class="soft">{rights.title[1]}</span></h2>
        <p>{rights.intro}</p>
      </div>
      <ol class="case-rights">
        {rights.items.map((r, i) => (
          <li class="reveal" style={`--i: ${i % 3}`}>
            <span class="case-rights__n" aria-hidden="true">{pad(i + 1)}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Provas: uma lista para marcar o que a pessoa já tem em mãos (só na tela, nada é enviado nem guardado) -->
  <section class="section section--tight" id="provas" data-secao="Provas" aria-labelledby="provas-titulo">
    <div class="container case-proof">
      <div class="reveal">
        <h2 class="display display--md" id="provas-titulo">{proof.title[0]} <span class="soft">{proof.title[1]}</span></h2>
        <p class="case-proof__intro">Marque o que você já tem. Se não tiver algum deles, não se preocupe: conversamos sobre isso.</p>
      </div>
      <div class="case-proof__sheet reveal" data-proof>
        <div class="case-proof__top">
          <span>Lista de documentos</span>
          <span class="case-proof__count" aria-live="polite"><b data-proof-count>0</b> de {proof.items.length} em mãos</span>
        </div>
        <span class="case-proof__bar" aria-hidden="true"><i data-proof-bar></i></span>
        <ul>
          {proof.items.map((d) => (
            <li><button type="button" aria-pressed="false"><span class="case-proof__box" aria-hidden="true"><Icon name="check" /></span>{d}</button></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. Prazos: faixa escura com os números grandes, que contam até o valor quando aparecem -->
  <section class="case-dark" id="prazos" data-secao="Prazos" aria-labelledby="prazos-titulo">
    <div class="container">
      <h2 class="display display--md display--inline reveal" id="prazos-titulo">{deadlines.title[0]} <span class="soft">{deadlines.title[1]}</span></h2>
      <ul class="case-dead">
        {deadlines.items.map((d) => {
          const m = splitValue(d.value);
          return (
            <li class="reveal">
              <p class="case-dead__value">
                {m ? <>{m[1]}<span data-count={m[2]}>{m[2]}</span>{m[3]}</> : d.value}
              </p>
              <p class="case-dead__text">{d.text}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- 7. Como funciona: a mesma linha do tempo de /empresas/, que se preenche com a rolagem -->
  <section class="section section--tight" id="como-funciona" data-secao="Como funciona" aria-labelledby="etapas-titulo">
    <div class="container">
      <div class="emp-time__head reveal">
        <h2 class="display display--inline display--md" id="etapas-titulo">Como funciona <span class="soft">o atendimento.</span></h2>
      </div>
      <div class="emp-time" data-timeline>
        <span class="emp-time__rail" aria-hidden="true"><span class="emp-time__fill" data-timeline-fill></span></span>
        <ol class="emp-time__list">
          {steps.map((s, i) => (
            <li class="emp-time__step" data-timeline-step>
              <span class="emp-time__node" aria-hidden="true">{pad(i + 1)}</span>
              <div class="emp-time__body">
                <p class="emp-time__phase">{phases[i]}</p>
                <h3 class="emp-time__title">{s.title}</h3>
                <p class="emp-time__text">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="section-cta">
        <Button href={wa!} icon="whatsapp" local={`${local}-etapas`} tema={slug} publico="trabalhador">Começar pelo WhatsApp</Button>
      </div>
    </div>
  </section>

  <!-- 8. Quem cuida do caso: mesma composição de /empresas/ (foto, frase em destaque e ficha pontilhada) -->
  <section class="section section--tight" data-secao="Quem cuida do caso" aria-labelledby="advogada-titulo">
    <div class="container emp-who">
      <figure class="emp-who__photo reveal">
        <Picture
          src={fotoPerfil}
          alt="Retrato da advogada trabalhista Giovanna Cabral"
          widths={[480, 720, 1000]}
          sizes="(min-width: 960px) 40vw, 100vw"
          formats={['avif', 'webp']}
        />
      </figure>
      <div class="reveal">
        <h2 class="emp-who__title" id="advogada-titulo">Quem cuida do seu caso.</h2>
        <p class="emp-who__quote">Explico cada etapa em linguagem simples, para você entender o que está acontecendo e decidir com segurança.</p>
        <p class="emp-who__bio">
          Sou advogada trabalhista, pós-graduada em Direito e Processo do Trabalho, e conduzo processos em todas as fases
          e instâncias, das audiências à sustentação oral nos tribunais. Você fala diretamente comigo, do primeiro
          contato ao fim do processo.
        </p>
        <dl class="emp-ficha">
          <div><dt>Inscrição</dt><dd>{site.oab}</dd></div>
          <div><dt>Formação</dt><dd>Pós em Direito e Processo do Trabalho</dd></div>
          <div><dt>Atuação</dt><dd>Todas as instâncias</dd></div>
          <div><dt>Atendimento</dt><dd>Online, todo o Brasil</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <RelatedPosts posts={related} topic={topic} />

  <!-- 9. Outros temas: índice com a frase de cada situação, para quem chegou ao tema errado -->
  {otherAreas.length > 0 && (
    <section class="section section--tight" data-secao="Outros temas" aria-labelledby="outros-titulo">
      <div class="container">
        <h2 class="display display--md display--inline case-head reveal" id="outros-titulo">Outros temas <span class="soft">em que posso ajudar.</span></h2>
        <ul class="case-others reveal">
          {otherAreas.map((a) => (
            <li>
              <a href={areaUrl(a.slug)}>
                <AreaIcon name={a.icon} class="case-others__icon" />
                <span><strong>{a.title}</strong><small>“{a.situation}”</small></span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 10. Dúvidas: entram na faixa do monograma do fim padrão, como na home e em /empresas/ -->
  <section class="section" id="duvidas" slot="antes-do-fim" data-secao="Dúvidas" aria-labelledby="duvidas-titulo">
    <div class="container faq faq--suave">
      <div class="faq__aside reveal">
        <h2 class="display display--inline" id="duvidas-titulo">Dúvidas <span class="soft">sobre {topic}.</span></h2>
        <p>Não encontrou a sua? <a href={wa} target="_blank" rel="noopener" data-local={`${local}-duvidas`} data-tema={slug} data-publico="trabalhador">Pergunte pelo WhatsApp</a>.</p>
      </div>
      <div class="faq__list reveal">
        {faq.map(({ q, a }) => (
          <details>
            <summary><h3 class="faq__q">{q}</h3></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initLeitura, initTimeline, onScroll } from '../scripts/leitura';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  initLeitura();
  initTimeline();

  // Topo: a foto de fundo sobe mais devagar que a página (só enquanto o topo está à vista)
  const top = document.querySelector<HTMLElement>('[data-case-top]');
  if (top && !reduce) {
    onScroll(() => {
      const h = top.offsetHeight;
      if (scrollY > h) return;
      top.style.setProperty('--shift', `${(scrollY * 0.25).toFixed(1)}px`);
    });
  }

  // Provas: marcar e desmarcar cada documento; a contagem e a barra acompanham
  const sheet = document.querySelector<HTMLElement>('[data-proof]');
  if (sheet) {
    const items = [...sheet.querySelectorAll<HTMLButtonElement>('button[aria-pressed]')];
    const count = sheet.querySelector<HTMLElement>('[data-proof-count]')!;
    const bar = sheet.querySelector<HTMLElement>('[data-proof-bar]')!;
    items.forEach((b) => b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
      const done = items.filter((x) => x.getAttribute('aria-pressed') === 'true').length;
      count.textContent = String(done);
      bar.style.transform = `scaleX(${done / items.length})`;
    }));
  }

  // Prazos: cada número conta de zero até o valor quando entra na tela
  const counters = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  if (!reduce) {
    const io = new IntersectionObserver((entries) => entries.forEach(({ target, isIntersecting }) => {
      if (!isIntersecting) return;
      io.unobserve(target);
      const el = target as HTMLElement;
      const to = Number(el.dataset.count);
      const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 1100);
        el.textContent = String(Math.round(to * (1 - (1 - p) ** 3)));
        if (p < 1) requestAnimationFrame(step);
      };
      el.textContent = '0';
      requestAnimationFrame(step);
    }), { threshold: 0.6 });
    counters.forEach((c) => io.observe(c));
  }
</script>
