---
// Ícones de linha fina (Lucide) usados soltos, sem fundo: "Sobre", contato e cartões de situações/direitos.
import graduationCap from 'lucide-static/icons/graduation-cap.svg?raw';
import award from 'lucide-static/icons/award.svg?raw';
import scrollText from 'lucide-static/icons/scroll-text.svg?raw';
import bookOpenText from 'lucide-static/icons/book-open-text.svg?raw';
import scale from 'lucide-static/icons/scale.svg?raw';
import users from 'lucide-static/icons/users.svg?raw';
import monitorSmartphone from 'lucide-static/icons/monitor-smartphone.svg?raw';
import badgeCheck from 'lucide-static/icons/badge-check.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import phone from 'lucide-static/icons/phone.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import lock from 'lucide-static/icons/lock.svg?raw';
import messageCircleMore from 'lucide-static/icons/message-circle-more.svg?raw';
import clipboardList from 'lucide-static/icons/clipboard-list.svg?raw';
import fileSignature from 'lucide-static/icons/file-signature.svg?raw';
import bellRing from 'lucide-static/icons/bell-ring.svg?raw';
import calendarClock from 'lucide-static/icons/calendar-clock.svg?raw';
import handshake from 'lucide-static/icons/handshake.svg?raw';
import type { LineIconName } from '../data/site';

// O Lucide tirou os ícones de marca do pacote; este é o mesmo desenho de linha do Instagram que ele tinha.
const instagram = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>';

const icons: Record<LineIconName, string> = {
  'graduation-cap': graduationCap,
  award,
  'scroll-text': scrollText,
  'book-open-text': bookOpenText,
  scale,
  users,
  'monitor-smartphone': monitorSmartphone,
  'badge-check': badgeCheck,
  'map-pin': mapPin,
  phone,
  clock,
  mail,
  lock,
  'message-circle-more': messageCircleMore,
  'clipboard-list': clipboardList,
  'file-signature': fileSignature,
  'bell-ring': bellRing,
  'calendar-clock': calendarClock,
  handshake,
  instagram,
};

interface Props {
  name: LineIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const svg = icons[name]
  .replace(/<!--[\s\S]*?-->/, '')
  .replace('stroke-width="2"', 'stroke-width="1.5" aria-hidden="true" focusable="false"');
---
<span class:list={['line-icon', className]} set:html={svg} />
