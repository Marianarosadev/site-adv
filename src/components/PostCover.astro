---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import bookOpen from 'lucide-static/icons/book-open-text.svg?raw';
import { categorySlug } from '../data/blog';

// Capa dos artigos. Com foto (campo cover do artigo), a foto ocupa a capa com um véu na cor do tema;
// sem foto, fica a capa tipográfica: etiqueta, tema em itálico e um livro aberto ao fundo.
// A cor muda conforme o tema (data-cat), para a lista do blog não ficar monótona.
interface Props {
  category: string;
  cover?: { src: ImageMetadata; alt: string; credit: string };
  sizes?: string;
  class?: string;
}

const { category, cover, sizes = '(min-width: 760px) 40vw, 100vw', class: className } = Astro.props;
const book = bookOpen
  .replace(/<!--[\s\S]*?-->/, '')
  .replace('stroke-width="2"', 'stroke-width="1.25" aria-hidden="true" focusable="false"');
---
<div class:list={['cover', { 'cover--photo': cover }, className]} data-cat={categorySlug(category)} aria-hidden="true">
  {cover ? (
    <Picture src={cover.src} alt="" widths={[240, 480, 800, 1200]} sizes={sizes} formats={['avif', 'webp']} class="cover__img" />
  ) : (
    <span class="cover__book" set:html={book} />
  )}
  <span class="cover__tag">Artigo</span>
  <span class="cover__cat">{category}</span>
</div>
