---
import { siWhatsapp } from 'simple-icons';

interface Props {
  name: 'whatsapp' | 'arrow';
}

const { name } = Astro.props;
---
{name === 'whatsapp' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={siWhatsapp.path} /></svg>
)}
{name === 'arrow' && (
  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
)}
