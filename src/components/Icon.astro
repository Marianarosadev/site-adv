---
import { siWhatsapp } from 'simple-icons';
import phone from 'lucide-static/icons/phone.svg?raw';
import book from 'lucide-static/icons/book-open-text.svg?raw';
import shield from 'lucide-static/icons/shield-check.svg?raw';
import user from 'lucide-static/icons/user-round.svg?raw';
import scale from 'lucide-static/icons/scale.svg?raw';
import briefcase from 'lucide-static/icons/briefcase-business.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import chevronLeft from 'lucide-static/icons/chevron-left.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import building from 'lucide-static/icons/building-2.svg?raw';

interface Props {
  name: 'whatsapp' | 'arrow' | 'phone' | 'book' | 'shield' | 'user' | 'scale' | 'briefcase' | 'check' | 'chevron-left' | 'chevron-right' | 'building';
}

const { name } = Astro.props;
const lucide = (svg: string) => svg
  .replace(/<!--[\s\S]*?-->/, '')
  .replace('stroke-width="2"', 'stroke-width="1.75" aria-hidden="true" focusable="false"');
---
{name === 'whatsapp' && (
  <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={siWhatsapp.path} /></svg>
)}
{name === 'arrow' && (
  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
)}
{name === 'phone' && <Fragment set:html={lucide(phone)} />}
{name === 'book' && <Fragment set:html={lucide(book)} />}
{name === 'shield' && <Fragment set:html={lucide(shield)} />}
{name === 'user' && <Fragment set:html={lucide(user)} />}
{name === 'scale' && <Fragment set:html={lucide(scale)} />}
{name === 'briefcase' && <Fragment set:html={lucide(briefcase)} />}
{name === 'check' && <Fragment set:html={lucide(check)} />}
{name === 'chevron-left' && <Fragment set:html={lucide(chevronLeft)} />}
{name === 'chevron-right' && <Fragment set:html={lucide(chevronRight)} />}
{name === 'building' && <Fragment set:html={lucide(building)} />}
