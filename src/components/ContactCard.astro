---
import Button from './Button.astro';
import { site, telLink } from '../data/site';

interface Props {
  whatsapp: string;
  checklist: string[];
  tema?: string;
  publico?: 'trabalhador' | 'empresa' | 'geral';
  title?: string;
}

const { whatsapp, checklist, tema, publico = 'geral', title = 'Fale comigo' } = Astro.props;
---
<div class="contact-card reveal">
  <h3>{title}</h3>
  <p class="contact-card__reply">{site.reply}</p>
  <div class="contact-card__actions">
    <Button href={whatsapp} icon="whatsapp" local="contato" tema={tema} publico={publico}>WhatsApp</Button>
    <Button href={telLink} icon="phone" local="contato" tema={tema} publico={publico}>Ligar</Button>
  </div>
  <dl class="contact-card__info">
    <div><dt>WhatsApp e telefone</dt><dd>{site.phoneDisplay}</dd></div>
    <div><dt>Horário</dt><dd>{site.hours}</dd></div>
    <div><dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
    <div><dt>Atendimento</dt><dd>Online · {site.city} e todo o Brasil</dd></div>
  </dl>
  <p class="contact-card__label">Para agilizar, conte na primeira mensagem:</p>
  <ul class="contact-card__list">
    {checklist.map((item) => <li>{item}</li>)}
  </ul>
  <p class="form-note">Não envie documentos ou informações sigilosas antes do primeiro retorno.</p>
</div>
