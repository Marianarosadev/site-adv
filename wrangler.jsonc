// Publicação na Cloudflare (Workers com arquivos estáticos).
// O site é 100% estático: o build do Astro gera a pasta dist/ e ela é servida como está.
// Ter este arquivo impede o "wrangler deploy" de reconfigurar o projeto com o adaptador do Astro.
{
  "name": "site-adv",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Endereços que não existem recebem a página 404.html do build, com status 404.
    "not_found_handling": "404-page"
  },
  // Homologação: Worker separado "site-adv-homologacao", publicado a partir da branch dev
  // com "npx wrangler deploy --env homologacao". O build roda com SITE_ENV=homologacao (variável
  // configurada no painel) para o site sair com "noindex" e sem ser indexado.
  "env": {
    "homologacao": {
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
